# ---------------------------------------------------------------------------
# Lumina Library · public build configuration
#
# VITE_* values are bundled into browser JavaScript. Only use Supabase's
# publishable key here. NEVER put a database password, secret key, service_role
# key, or user password in a VITE_* variable.
# ---------------------------------------------------------------------------

# Supabase Dashboard → Project Settings → API Keys / Connect.
# Leave either blank to run the local demo. The publishable key is safe to ship
# only because setup.sql denies direct table access and exposes a role-checked RPC.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy Google Sheets URL is intentionally disabled and ignored by the current app.
# VITE_API_BASE_URL=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=30000

# Keep false outside development. This does not enable backend demo credentials.
VITE_SHOW_DEMO_HINTS=false
