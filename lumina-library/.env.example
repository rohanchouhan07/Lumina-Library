# ---------------------------------------------------------------------------
# Lumina Library — public build configuration
# Copy to `.env` and fill in your own values. NOTHING SECRET GOES IN THIS FILE:
# Vite inlines every VITE_* variable into the browser bundle.
# ---------------------------------------------------------------------------

# Apps Script Web App URL (Deploy → Web app → /exec). Leave empty to run the
# offline demo with seeded local data instead of a backend.
#
#   empty            → Demo mode (role cards, localStorage, no server calls)
#   /api             → local contract mock (npm run dev:mock, needs the mock on :8100)
#   https://…/exec   → the real deployment (email/ID + password sign-in)
#
# Only set the /exec URL once `node ../qa-tools/api-smoke.mjs` passes against it.
#
# This file is the template. The value that actually applies on your machine lives in
# `.env.local` (git-ignored). To go back to the offline demo, empty it there or run
# `npm run dev:demo`.
VITE_API_BASE_URL=

# How long a request may take before the UI shows a timeout error (ms).
# Apps Script cold starts run 3-10 s; password calls (sign-in, account creation) get a
# fixed 60 s budget of their own because the hash runs remotely.
VITE_API_TIMEOUT_MS=30000

# Show the demo account hints on the login screen (dev convenience only).
VITE_SHOW_DEMO_HINTS=true
