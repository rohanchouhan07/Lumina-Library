/**
 * How a legacy tab is recognised when it does not carry the canonical tab name.
 * `KEYS` must all be present in the header row; `NOT` must be absent. Together
 * they stop e.g. the Loans tab being mistaken for Wishlists (both carry a
 * "User ID" column). Matching never renames or rewrites a tab.
 */
var SHEET_MATCH = {
  BOOKS: { KEYS: ['Book ID', 'Title'], NOT: [] },
  USERS: { KEYS: ['User ID', 'Email', 'Password hash'], NOT: ['Loan ID'] },
  LOANS: { KEYS: ['Loan ID', 'Book ID', 'Due date'], NOT: [] },
  RESERVATIONS: { KEYS: ['Reservation ID', 'Book ID'], NOT: ['Loan ID'] },
  ACTIVITY: { KEYS: ['Activity ID', 'Summary'], NOT: [] },
  SETTINGS: { KEYS: ['Key', 'Value'], NOT: ['Book ID', 'User ID'] },
  SESSIONS: { KEYS: ['Token hash'], NOT: [] },
  WISHLISTS: { KEYS: ['User ID', 'Book ID', 'Created at'], NOT: ['Loan ID', 'Reservation ID', 'Password hash'] },
};

/** Roles are normalised to these three values everywhere. */
/**
 * Roles.
 *   ADMIN     — everything, including policy and other administrators.
 *   LIBRARIAN — runs the desk: inventory, members, circulation, holds, reports.
 *               Cannot change circulation policy, read diagnostics or touch ADMIN accounts.
 *   FACULTY   — borrower with a higher limit.
 *   STUDENT   — borrower.
 */
var ROLES = { ADMIN: 'ADMIN', LIBRARIAN: 'LIBRARIAN', FACULTY: 'FACULTY', STUDENT: 'STUDENT' };
var ROLE_LIST = [ROLES.ADMIN, ROLES.LIBRARIAN, ROLES.FACULTY, ROLES.STUDENT];
/** Roles that may be assigned by someone who is not an administrator. */
var ASSIGNABLE_BY_LIBRARIAN = [ROLES.LIBRARIAN, ROLES.FACULTY, ROLES.STUDENT];
var STATUS = { ACTIVE: 'ACTIVE', INACTIVE: 'INACTIVE' };

function spreadsheet_() {
  var props = PropertiesService.getScriptProperties();
  var bound = props.getProperty('SPREADSHEET_ID');
  if (bound) return SpreadsheetApp.openById(bound);
  try {
    return SpreadsheetApp.getActiveSpreadsheet();
  } catch (err) {
    return SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  }
}

/* ===================== Validation.gs ===================== */

/**
 * Validation.gs — input validation, sanitisation and safe error handling.
 * Every value that reaches a cell passes through here.
 */
var ERR = {
  VALIDATION: 'VALIDATION_ERROR',
  UNAUTHORIZED: 'UNAUTHORIZED',
  FORBIDDEN: 'FORBIDDEN',
  NOT_FOUND: 'NOT_FOUND',
  CONFLICT: 'CONFLICT',
  RATE_LIMITED: 'RATE_LIMITED',
  SERVER: 'SERVER_ERROR',
  CONFIG: 'CONFIG_ERROR',
};

function appError_(code, message) {
  var err = new Error(message);
  err.appCode = code;
  return err;
}

/** Formula / CSV injection guard: a leading = + - @ is neutralised with a quote. */
function sanitizeText_(value, maxLength) {
  if (value === null || value === undefined) return '';
  var text = String(value).replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g, '').trim();
  if (/^[=+\-@\t\r]/.test(text)) text = "'" + text;
  var limit = maxLength || 500;
  return text.length > limit ? text.slice(0, limit) : text;
}

function requireString_(value, field, min, max) {
  var text = sanitizeText_(value, max || 500);
  if (!text || text.length < (min || 1)) {
    throw appError_(ERR.VALIDATION, field + ' is required.');
  }
  return text;
}

function optionalString_(value, max) {
  return sanitizeText_(value, max || 500);
}

function requireEmail_(value) {
  var email = sanitizeText_(value, 200).toLowerCase();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
    throw appError_(ERR.VALIDATION, 'Enter a valid email address.');
  }
  if (CONFIG.EMAIL_DOMAIN && email.split('@')[1] !== CONFIG.EMAIL_DOMAIN.toLowerCase()) {
    throw appError_(ERR.VALIDATION, 'Only @' + CONFIG.EMAIL_DOMAIN + ' addresses can sign in.');
  }
  return email;
}

function requireInt_(value, field, min, max) {
  var number = Number(value);
  if (!isFinite(number) || Math.floor(number) !== number) {
    throw appError_(ERR.VALIDATION, field + ' must be a whole number.');
  }
  if (number < min || number > max) {
    throw appError_(ERR.VALIDATION, field + ' must be between ' + min + ' and ' + max + '.');
  }
  return number;
}

function requireEnum_(value, field, allowed) {
  var text = String(value || '').toUpperCase().trim();
  if (allowed.indexOf(text) === -1) {
    throw appError_(ERR.VALIDATION, field + ' must be one of: ' + allowed.join(', ') + '.');
  }
  return text;
}

function requireId_(value, field) {
  var text = sanitizeText_(value, 60);
  if (!/^[A-Za-z0-9_-]{3,60}$/.test(text)) {
    throw appError_(ERR.VALIDATION, (field || 'Identifier') + ' is invalid.');
  }
  return text;
}

function requirePassword_(value) {
  var password = String(value || '');
  if (password.length < CONFIG.MIN_PASSWORD_LENGTH) {
    throw appError_(ERR.VALIDATION, 'Password must be at least ' + CONFIG.MIN_PASSWORD_LENGTH + ' characters.');
  }
  if (password.length > 200) throw appError_(ERR.VALIDATION, 'Password is too long.');
  if (!/[A-Za-z]/.test(password) || !/[0-9]/.test(password)) {
    throw appError_(ERR.VALIDATION, 'Password must contain at least one letter and one number.');
  }
  return password;
}

function parseIsoDate_(value, field) {
  var text = String(value || '').trim();
  if (!text) throw appError_(ERR.VALIDATION, field + ' is required.');
  var date = new Date(text);
  if (isNaN(date.getTime())) throw appError_(ERR.VALIDATION, field + ' is not a valid date.');
  return date;
}

/** Normalised API response envelope: { ok, data } or { ok, error: { code, message } }. */
function ok_(data) {
  return { ok: true, data: data === undefined ? null : data };
}

function fail_(code, message) {
  return { ok: false, error: { code: code, message: message } };
}

/** Never leak a stack trace, token or password hash to the client. */
function failFromError_(err) {
  var code = err && err.appCode ? err.appCode : ERR.SERVER;
  var message =
    code === ERR.SERVER
      ? 'The server could not complete that request. Please retry.'
      : err && err.message
        ? err.message
        : 'Request failed.';
  if (code === ERR.SERVER) {
    try {
      console.error('Lumina API error: ' + (err && err.message));
    } catch (ignored) {}
  }
  return fail_(code, message);
}

/* ===================== SheetDb.gs ===================== */

/**
 * SheetDb.gs — the only place that touches SpreadsheetApp.
 *
 * Design rules:
 *  • Never delete, rename or reorder an existing tab or column.
 *  • Only ever append: missing tabs get created, missing headers get appended to
 *    the right of the existing header row, records get appended as new rows.
 *  • Column positions are always read from the sheet's own header row, so a
 *    legacy layout with extra/reordered columns still round-trips correctly.
 *  • Tabs are resolved by name first, then by header signature (see SHEET_MATCH
 *    in Config.gs) so a workbook with different tab names keeps its data.
 */

/** Normalise a header for comparison: lower-case alphanumerics only. */
function headerKey_(header) {
  return String(header)
    .toLowerCase()
    .replace(/[^a-z0-9]/g, '');
}

/** Read the header row of a tab, trimmed, as strings. Never throws on an empty tab. */
function readHeaderRow_(sheet) {
  var lastColumn = sheet.getLastColumn();
  if (lastColumn < 1) return [];
  return sheet
    .getRange(1, 1, 1, lastColumn)
    .getValues()[0]
    .map(function (header) {
      return String(header).trim();
    });
}

/**
 * Find the tab that holds a logical table:
 *   1. exact tab-name match,
 *   2. a tab whose header row carries every key header and none of the
 *      conflicting ones (SHEET_MATCH),
 *   3. null — the caller decides whether to create it.
 */
function findSheet_(kind, sheetName) {
  var book = spreadsheet_();
  var byName = book.getSheetByName(sheetName);
  if (byName) return byName;

  var match = SHEET_MATCH[kind];
  if (!match) return null;
  var keys = match.KEYS.map(headerKey_);
  var blocked = (match.NOT || []).map(headerKey_);

  var sheets = book.getSheets();
  for (var i = 0; i < sheets.length; i += 1) {
    var sheet = sheets[i];
    if (sheet.getLastColumn() < 1) continue;
    var headers = readHeaderRow_(sheet).map(headerKey_);
    var hasAllKeys = keys.every(function (key) {
      return headers.indexOf(key) !== -1;
    });
    if (!hasAllKeys) continue;
    var hasBlocked = blocked.some(function (key) {
      return headers.indexOf(key) !== -1;
    });
    if (hasBlocked) continue;
    return sheet;
  }
  return null;
}

/** Get a tab, creating it with canonical headers only when it does not exist. */
function ensureSheet_(kind, sheetName) {
  var sheet = findSheet_(kind, sheetName);
  if (sheet) {
    ensureHeaders_(sheet, CONFIG.HEADERS[kind]);
    return sheet;
  }
  var book = spreadsheet_();
  sheet = book.insertSheet(sheetName);
  var headers = CONFIG.HEADERS[kind];
  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  sheet.setFrozenRows(1);
  sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
  return sheet;
}

/** Append any missing headers to the right of the existing ones; existing columns stay put. */
function ensureHeaders_(sheet, headers) {
  var existing = readHeaderRow_(sheet);
  var existingKeys = existing.map(headerKey_);
  var missing = headers.filter(function (header) {
    return existingKeys.indexOf(headerKey_(header)) === -1;
  });
  if (!missing.length) return existing;
  sheet.getRange(1, existing.length + 1, 1, missing.length).setValues([missing]);
  return existing.concat(missing);
}

/**
 * Read a tab as objects keyed by its own header row, with `_row` for updates.
 * Fully blank rows are skipped (they are invisible to the app but preserved).
 */
function readTable_(kind, sheetName) {
  var sheet = ensureSheet_(kind, sheetName);
  var headers = readHeaderRow_(sheet);
  if (!headers.length) return { sheet: sheet, headers: CONFIG.HEADERS[kind], rows: [] };

  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return { sheet: sheet, headers: headers, rows: [] };

  var values = sheet.getRange(2, 1, lastRow - 1, headers.length).getValues();
  var rows = [];
  for (var i = 0; i < values.length; i += 1) {
    var raw = values[i];
    var blank = raw.every(function (cell) {
      return String(cell).trim() === '';
    });
    if (blank) continue;
    var record = { _row: i + 2 };
    for (var c = 0; c < headers.length; c += 1) {
      if (!headers[c]) continue;
      record[headers[c]] = raw[c];
    }
    rows.push(record);
  }
  return { sheet: sheet, headers: headers, rows: rows };
}

/** Map of header → 1-based column index, derived from the sheet's header row. */
function columnMap_(headers) {
  var map = {};
  headers.forEach(function (header, index) {
    if (header) map[String(header).trim()] = index + 1;
  });
  return map;
}

/** Append one record (object keyed by header). Values outside the header set are ignored. */
function appendRecord_(sheet, headers, record) {
  var row = headers.map(function (header) {
    var value = record[header];
    return value === undefined || value === null ? '' : value;
  });
  sheet.appendRow(row);
  return sheet.getLastRow();
}

/** Update selected fields of one existing row, addressed by its real row number. */
function updateRecord_(sheet, headers, rowNumber, record) {
  var columns = columnMap_(headers);
  Object.keys(record).forEach(function (header) {
    var column = columns[header];
    if (!column) return;
    var value = record[header];
    sheet.getRange(rowNumber, column).setValue(value === undefined || value === null ? '' : value);
  });
}

/** Delete exactly one row (used only by explicit admin "delete empty record" paths). */
function deleteRow_(sheet, rowNumber) {
  if (!rowNumber || rowNumber < 2) return;
  sheet.deleteRow(rowNumber);
}

/**
 * Write one column of derived values, preserving alignment even when the sheet
 * has blank rows in the middle: contiguous data is written as a single batch,
 * otherwise row by row.
 */
function writeColumn_(sheet, rows, header, headerRow, valueFor) {
  var column = headerRow[header];
  if (!column || !rows.length) return;
  var contiguous = rows.every(function (row, index) {
    return row._row === rows[0]._row + index;
  });
  if (contiguous) {
    sheet
      .getRange(rows[0]._row, column, rows.length, 1)
      .setValues(
        rows.map(function (row) {
          return [valueFor(row)];
        }),
      );
    return;
  }
  rows.forEach(function (row) {
    sheet.getRange(row._row, column).setValue(valueFor(row));
  });
}

/**
 * Run a mutation under the script lock so two concurrent requests cannot both
 * pass the same check. Sheets has no transactions, so critical paths re-read
 * their data inside the lock.
 */
function withLock_(fn) {
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000);
  } catch (err) {
    throw appError_(ERR.CONFLICT, 'The library is busy processing another change. Please retry.');
  }
  try {
    return fn();
  } finally {
    lock.releaseLock();
  }
}

/** Sequential, collision-free ids: PREFIX-0001 derived from the highest existing number. */
function nextId_(prefix, rows, idHeader) {
  var max = 0;
  rows.forEach(function (row) {
    var value = String(row[idHeader] || '');
    var match = value.match(/(\d+)\s*$/);
    if (match) max = Math.max(max, Number(match[1]));
  });
  return prefix + '-' + String(max + 1).padStart(4, '0');
}

/* ===================== AuthService.gs ===================== */

/**
 * AuthService.gs — password hashing, sessions and role checks.
 *
 * Security model (documented in docs/SECURITY.md):
 *  • Passwords: salted, iterated HMAC-SHA256 (Apps Script has no PBKDF2/argon2).
 *  • Sessions: opaque random token, only its SHA-256 hash is stored in the sheet.
 *  • Roles: always read from the Users sheet on every request — never from the client.
 *  • Everything runs with the deploying account's permissions; the sheet itself is
 *    never reachable from the browser except through these service functions.
 */
var SESSION_ACTIONS = {};

function hashPassword_(password, salt, iterations) {
  var rounds = iterations || CONFIG.HASH_ITERATIONS;
  var value = salt + ':' + password;
  for (var i = 0; i < rounds; i += 1) {
    var bytes = Utilities.computeHmacSha256Signature(value, salt + ':' + i, Utilities.Charset.UTF_8);
    value = bytes
      .map(function (b) {
        return ('0' + (b & 0xff).toString(16)).slice(-2);
      })
      .join('');
  }
  return value;
}

function newSalt_() {
  return Utilities.getUuid().replace(/-/g, '');
}

function sha256Hex_(text) {
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, text, Utilities.Charset.UTF_8);
  return bytes
    .map(function (b) {
      return ('0' + (b & 0xff).toString(16)).slice(-2);
    })
    .join('');
}

function newToken_() {
  return (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, '');
}

/* ------------------------------------------------------------------ sessions */

function pruneSessions_(rows) {
  var now = Date.now();
  return rows.filter(function (row) {
    var expires = new Date(row['Expires at']).getTime();
    var revoked = String(row.Revoked).toUpperCase() === 'TRUE';
    return !revoked && !isNaN(expires) && expires > now;
  });
}

function createSession_(userId, remember) {
  var hours = CONFIG.SESSION_HOURS * (remember ? CONFIG.REMEMBER_MULTIPLIER : 1);
  var token = newToken_();
  var now = new Date();
  var expires = new Date(now.getTime() + hours * 3600 * 1000);
  var store = readTable_('SESSIONS', CONFIG.SHEETS.SESSIONS);
  // Prune expired rows so the tab does not grow forever.
  var keep = pruneSessions_(store.rows);
  if (keep.length !== store.rows.length) {
    var dead = store.rows.filter(function (row) {
      return keep.indexOf(row) === -1;
    });
    dead
      .sort(function (a, b) {
        return b._row - a._row;
      })
      .forEach(function (row) {
        store.sheet.deleteRow(row._row);
      });
  }
  appendRecord_(store.sheet, store.headers, {
    'Token hash': sha256Hex_(token),
    'User ID': userId,
    'Created at': now.toISOString(),
    'Expires at': expires.toISOString(),
    'Last seen': now.toISOString(),
    Revoked: 'FALSE',
  });
  return { token: token, expiresAt: expires.toISOString() };
}

/** Revoke every session for a user except the one making the request. */
function revokeOtherSessions_(userId, keepToken) {
  var keepHash = keepToken ? sha256Hex_(keepToken) : '';
  var store = readTable_('SESSIONS', CONFIG.SHEETS.SESSIONS);
  var revoked = 0;
  store.rows.forEach(function (row) {
    if (String(row['User ID']) !== userId) return;
    if (String(row.Revoked).toUpperCase() === 'TRUE') return;
    if (keepHash && String(row['Token hash']) === keepHash) return;
    updateRecord_(store.sheet, store.headers, row._row, { Revoked: 'TRUE' });
    revoked += 1;
  });
  return revoked;
}

function revokeSession_(token) {
  if (!token) return;
  var store = readTable_('SESSIONS', CONFIG.SHEETS.SESSIONS);
  var hash = sha256Hex_(token);
  store.rows.forEach(function (row) {
    if (String(row['Token hash']) === hash) {
      updateRecord_(store.sheet, store.headers, row._row, { Revoked: 'TRUE' });
    }
  });
}

/**
 * Resolve the caller. Returns { user, session } where user is the *current*
 * Users-sheet record, so deactivating an account takes effect immediately.
 */
function requireSession_(token) {
  if (!token) throw appError_(ERR.UNAUTHORIZED, 'Sign in to continue.');
  var hash = sha256Hex_(String(token));
  var store = readTable_('SESSIONS', CONFIG.SHEETS.SESSIONS);
  var match = null;
  for (var i = 0; i < store.rows.length; i += 1) {
    if (String(store.rows[i]['Token hash']) === hash) {
      match = store.rows[i];
      break;
    }
  }
  if (!match) throw appError_(ERR.UNAUTHORIZED, 'Your session has expired. Sign in again.');
  if (String(match.Revoked).toUpperCase() === 'TRUE') {
    throw appError_(ERR.UNAUTHORIZED, 'Your session has ended. Sign in again.');
  }
  if (new Date(match['Expires at']).getTime() < Date.now()) {
    updateRecord_(store.sheet, store.headers, match._row, { Revoked: 'TRUE' });
    throw appError_(ERR.UNAUTHORIZED, 'Your session has expired. Sign in again.');
  }

  var users = readTable_('USERS', CONFIG.SHEETS.USERS).rows;
  var user = findById_(users, 'User ID', match['User ID']);
  if (!user) throw appError_(ERR.UNAUTHORIZED, 'This account no longer exists.');
  if (String(user['Account status']).toUpperCase() !== STATUS.ACTIVE) {
    throw appError_(ERR.FORBIDDEN, 'This account is deactivated. Contact the library administrator.');
  }
  updateRecord_(store.sheet, store.headers, match._row, { 'Last seen': new Date().toISOString() });
  return { user: user, session: match, token: token };
}

function requireRole_(auth, allowed) {
  var role = normaliseRole_(auth.user.Role);
  if (allowed.indexOf(role) === -1) {
    throw appError_(ERR.FORBIDDEN, 'Your role does not allow this action.');
  }
  return role;
}

function normaliseRole_(value) {
  var role = String(value || '').toUpperCase().trim();
  if (role === 'LIBRARIAN' || role === 'STAFF' || role === 'DESK') return ROLES.LIBRARIAN;
  if (role === 'TEACHER') return ROLES.FACULTY;
  if (role === 'ADMINISTRATOR' || role === 'SUPERADMIN') return ROLES.ADMIN;
  return ROLE_LIST.indexOf(role) === -1 ? ROLES.STUDENT : role;
}

/** Anyone who works the desk: sees the whole library, not just their own records. */
function isStaff_(role) {
  return role === ROLES.ADMIN || role === ROLES.LIBRARIAN;
}

/** Public projection of a user — never includes hash, salt or iterations. */
function publicUser_(user) {
  return {
    userId: String(user['User ID']),
    name: String(user.Name),
    email: String(user.Email).toLowerCase(),
    institutionalId: String(user['Institutional ID'] || ''),
    role: normaliseRole_(user.Role),
    department: String(user.Department || ''),
    accountStatus: String(user['Account status'] || STATUS.ACTIVE).toUpperCase(),
    phone: String(user.Phone || ''),
    borrowingLimit: user['Borrowing limit'] === '' ? null : Number(user['Borrowing limit']),
    createdAt: String(user['Created at'] || ''),
    updatedAt: String(user['Updated at'] || ''),
  };
}

/* --------------------------------------------------------------------- login */

function authLogin_(payload) {
  var identifier = sanitizeText_(payload.identifier, 200).toLowerCase();
  var password = String(payload.password || '');
  if (!identifier || !password) {
    throw appError_(ERR.VALIDATION, 'Enter your email or institutional ID and your password.');
  }
  if (isLoginThrottled_(identifier)) {
    throw appError_(ERR.RATE_LIMITED, 'Too many attempts. Wait a few minutes and try again.');
  }

  var users = readTable_('USERS', CONFIG.SHEETS.USERS).rows;
  var user = null;
  for (var i = 0; i < users.length; i += 1) {
    var email = String(users[i].Email || '').toLowerCase();
    var institutional = String(users[i]['Institutional ID'] || '').toLowerCase();
    if (email === identifier || (institutional && institutional === identifier)) {
      user = users[i];
      break;
    }
  }

  var store = readTable_('USERS', CONFIG.SHEETS.USERS);
  if (!user) {
    recordLoginAttempt_(identifier, false);
    throw appError_(ERR.UNAUTHORIZED, 'Email/ID or password is incorrect.');
  }
  if (String(user['Account status']).toUpperCase() !== STATUS.ACTIVE) {
    throw appError_(ERR.FORBIDDEN, 'This account is deactivated. Contact the library administrator.');
  }

  var iterations = Number(user['Hash iterations']) || CONFIG.HASH_ITERATIONS;
  var computed = hashPassword_(password, String(user['Password salt']), iterations);
  if (computed !== String(user['Password hash'])) {
    recordLoginAttempt_(identifier, false);
    throw appError_(ERR.UNAUTHORIZED, 'Email/ID or password is incorrect.');
  }

  var session = createSession_(String(user['User ID']), Boolean(payload.remember));
  recordLoginAttempt_(identifier, true);

  var patch = { 'Updated at': new Date().toISOString() };
  if (iterations !== CONFIG.HASH_ITERATIONS) {
    // Stored with an older work factor — re-hash now that we have the plaintext, so the
    // next sign-in is as fast as the policy intends.
    var newSalt = newSalt_();
    patch['Password salt'] = newSalt;
    patch['Password hash'] = hashPassword_(password, newSalt, CONFIG.HASH_ITERATIONS);
    patch['Hash iterations'] = CONFIG.HASH_ITERATIONS;
  }
  updateRecord_(store.sheet, store.headers, user._row, patch);
  logActivity_(String(user['User ID']), 'auth.login', 'user', String(user['User ID']), 'Signed in');
  return { token: session.token, expiresAt: session.expiresAt, user: publicUser_(user) };
}

/* --------------------------------------------------- throttling (best effort) */

function throttleStore_() {
  return PropertiesService.getScriptProperties();
}

function isLoginThrottled_(identifier) {
  try {
    var raw = throttleStore_().getProperty('login.' + sha256Hex_(identifier));
    if (!raw) return false;
    var record = JSON.parse(raw);
    if (Date.now() - record.first > CONFIG.LOGIN_WINDOW_MINUTES * 60000) return false;
    return record.count >= CONFIG.LOGIN_MAX_ATTEMPTS;
  } catch (err) {
    return false;
  }
}

function recordLoginAttempt_(identifier, success) {
  try {
    var key = 'login.' + sha256Hex_(identifier);
    if (success) {
      throttleStore_().deleteProperty(key);
      return;
    }
    var raw = throttleStore_().getProperty(key);
    var record = raw ? JSON.parse(raw) : { first: Date.now(), count: 0 };
    if (Date.now() - record.first > CONFIG.LOGIN_WINDOW_MINUTES * 60000) {
      record = { first: Date.now(), count: 0 };
    }
    record.count += 1;
    throttleStore_().setProperty(key, JSON.stringify(record));
  } catch (err) {
    // Throttling is best-effort; never block a login because of it.
  }
}

function authLogout_(auth) {
  revokeSession_(auth.token);
  logActivity_(String(auth.user['User ID']), 'auth.logout', 'user', String(auth.user['User ID']), 'Signed out');
  return { loggedOut: true };
}

function authChangePassword_(auth, payload) {
  var current = String(payload.currentPassword || '');
  var next = requirePassword_(payload.newPassword);
  var user = auth.user;
  var iterations = Number(user['Hash iterations']) || CONFIG.HASH_ITERATIONS;
  if (hashPassword_(current, String(user['Password salt']), iterations) !== String(user['Password hash'])) {
    throw appError_(ERR.UNAUTHORIZED, 'Your current password is incorrect.');
  }
  var salt = newSalt_();
  var store = readTable_('USERS', CONFIG.SHEETS.USERS);
  updateRecord_(store.sheet, store.headers, user._row, {
    'Password salt': salt,
    'Password hash': hashPassword_(next, salt, CONFIG.HASH_ITERATIONS),
    'Hash iterations': CONFIG.HASH_ITERATIONS,
    'Updated at': new Date().toISOString(),
  });
  // A changed password must end every *other* session — otherwise a stolen token keeps
  // working because the hash changed underneath it. The caller keeps their own session.
  var revoked = revokeOtherSessions_(String(user['User ID']), String(auth.token || ''));
  logActivity_(
    String(user['User ID']),
    'user.password',
    'user',
    String(user['User ID']),
    'Changed own password' + (revoked ? ' (signed out ' + revoked + ' other session(s))' : ''),
  );
  return { changed: true, sessionsRevoked: revoked };
}

function findById_(rows, header, id) {
  for (var i = 0; i < rows.length; i += 1) {
    if (String(rows[i][header]) === String(id)) return rows[i];
  }
  return null;
}

/* ===================== MembersService.gs ===================== */

/**
 * MembersService.gs — user/member administration (ADMIN only, except self-profile).
 * Roles: ADMIN, FACULTY, STUDENT. Only an ADMIN can create ADMIN accounts.
 */
function mapUser_(user, loans, reservations) {
  var publicData = publicUser_(user);
  var id = publicData.userId;
  var active = (loans || []).filter(function (loan) {
    return String(loan['User ID']) === id && String(loan['Loan status']).toUpperCase() === 'ACTIVE';
  });
  var holds = (reservations || []).filter(function (reservation) {
    var status = String(reservation['Reservation status'] || '').toUpperCase();
    return String(reservation['User ID']) === id && (status === 'PENDING' || status === 'READY');
  });
  publicData.activeLoans = active.length;
  publicData.activeHolds = holds.length;
  publicData.outstandingFine = (loans || []).reduce(function (sum, loan) {
    if (String(loan['User ID']) !== id) return sum;
    var status = String(loan['Loan status']).toUpperCase();
    var fine = Number(loan['Fine amount']) || 0;
    if (status === 'ACTIVE') {
      var days = overdueDays_(loan['Due date']);
      return sum + days * finePerDay_();
    }
    return sum + (status === 'RETURNED' ? fine : 0);
  }, 0);
  return publicData;
}

function listUsers_(auth, params) {
  requireRole_(auth, [ROLES.ADMIN, ROLES.LIBRARIAN]);
  var store = readTable_('USERS', CONFIG.SHEETS.USERS);
  var loans = readTable_('LOANS', CONFIG.SHEETS.LOANS).rows;
  var reservations = readTable_('RESERVATIONS', CONFIG.SHEETS.RESERVATIONS).rows;
  var role = params && params.role ? String(params.role).toUpperCase() : '';
  var users = store.rows
    .filter(function (row) {
      return Boolean(row['User ID']);
    })
    .map(function (row) {
      return mapUser_(row, loans, reservations);
    })
    .filter(function (user) {
      return !role || user.role === role;
    });
  return { users: users, total: users.length };
}

function validateUserPayload_(payload, isCreate, actorRole) {
  var fields = {
    Name: requireString_(payload.name, 'Name', 2, 120),
    Email: requireEmail_(payload.email),
    'Institutional ID': requireString_(payload.institutionalId, 'Institutional ID', 2, 40),
    Role: requireEnum_(payload.role, 'Role', ROLE_LIST),
    Department: optionalString_(payload.department, 120),
    Phone: optionalString_(payload.phone, 30),
  };
  if (fields.Role === ROLES.ADMIN && actorRole !== ROLES.ADMIN) {
    throw appError_(ERR.FORBIDDEN, 'Only an administrator can create or promote administrator accounts.');
  }
  if (actorRole !== ROLES.ADMIN && ASSIGNABLE_BY_LIBRARIAN.indexOf(fields.Role) === -1) {
    throw appError_(ERR.FORBIDDEN, 'Only an administrator can assign that role.');
  }
  if (payload.borrowingLimit !== undefined && payload.borrowingLimit !== '' && payload.borrowingLimit !== null) {
    fields['Borrowing limit'] = requireInt_(payload.borrowingLimit, 'Borrowing limit', 0, 50);
  } else {
    fields['Borrowing limit'] = '';
  }
  if (isCreate) {
    fields['Account status'] = payload.accountStatus
      ? requireEnum_(payload.accountStatus, 'Account status', ['ACTIVE', 'INACTIVE'])
      : STATUS.ACTIVE;
  } else if (payload.accountStatus) {
    fields['Account status'] = requireEnum_(payload.accountStatus, 'Account status', ['ACTIVE', 'INACTIVE']);
  }
  return fields;
}

/**
 * A librarian runs the desk, but cannot act on an administrator account — otherwise the
 * desk role would be a path to taking over the library.
 */
function assertCanManageTarget_(actorRole, targetRow, verb) {
  if (actorRole === ROLES.ADMIN) return;
  if (normaliseRole_(targetRow.Role) === ROLES.ADMIN) {
    throw appError_(ERR.FORBIDDEN, 'Only an administrator can ' + verb + ' an administrator account.');
  }
}

function assertUniqueUser_(rows, fields, ignoreId) {
  var email = fields.Email.toLowerCase();
  var institutional = fields['Institutional ID'].toLowerCase();
  for (var i = 0; i < rows.length; i += 1) {
    var row = rows[i];
    if (ignoreId && String(row['User ID']) === String(ignoreId)) continue;
    if (String(row.Email || '').toLowerCase() === email) {
      throw appError_(ERR.CONFLICT, 'That email is already registered.');
    }
    if (String(row['Institutional ID'] || '').toLowerCase() === institutional) {
      throw appError_(ERR.CONFLICT, 'That institutional ID is already registered.');
    }
  }
}

function createUser_(auth, payload) {
  var actorRole = requireRole_(auth, [ROLES.ADMIN, ROLES.LIBRARIAN]);
  return withLock_(function () {
    var store = readTable_('USERS', CONFIG.SHEETS.USERS);
    var fields = validateUserPayload_(payload, true, actorRole);
    assertUniqueUser_(store.rows, fields, null);
    var password = requirePassword_(payload.password);
    var salt = newSalt_();
    var now = new Date().toISOString();
    var record = {};
    Object.keys(fields).forEach(function (key) {
      record[key] = fields[key];
    });
    record['User ID'] = nextId_('U', store.rows, 'User ID');
    record['Password salt'] = salt;
    record['Password hash'] = hashPassword_(password, salt, CONFIG.HASH_ITERATIONS);
    record['Hash iterations'] = CONFIG.HASH_ITERATIONS;
    record['Created at'] = now;
    record['Updated at'] = now;
    appendRecord_(store.sheet, store.headers, record);
    logActivity_(
      String(auth.user['User ID']),
      'user.created',
      'user',
      record['User ID'],
      'Created ' + record.Role + ' account for ' + record.Name,
    );
    return { user: publicUser_(record) };
  });
}

function updateUser_(auth, payload) {
  var actorRole = requireRole_(auth, [ROLES.ADMIN, ROLES.LIBRARIAN]);
  return withLock_(function () {
    var userId = requireId_(payload.userId, 'User ID');
    var store = readTable_('USERS', CONFIG.SHEETS.USERS);
    var row = findById_(store.rows, 'User ID', userId);
    if (!row) throw appError_(ERR.NOT_FOUND, 'That account does not exist.');
    assertCanManageTarget_(actorRole, row, 'edit');
    var fields = validateUserPayload_(payload, false, actorRole);
    assertUniqueUser_(store.rows, fields, userId);
    fields['Updated at'] = new Date().toISOString();
    if (payload.password) {
      var salt = newSalt_();
      fields['Password salt'] = salt;
      fields['Password hash'] = hashPassword_(requirePassword_(payload.password), salt, CONFIG.HASH_ITERATIONS);
      fields['Hash iterations'] = CONFIG.HASH_ITERATIONS;
    }
    updateRecord_(store.sheet, store.headers, row._row, fields);
    logActivity_(
      String(auth.user['User ID']),
      'user.updated',
      'user',
      userId,
      'Updated account for ' + fields.Name,
    );
    return { user: publicUser_(Object.assign({}, row, fields)) };
  });
}

function setUserStatus_(auth, payload) {
  var actorRole = requireRole_(auth, [ROLES.ADMIN, ROLES.LIBRARIAN]);
  return withLock_(function () {
    var userId = requireId_(payload.userId, 'User ID');
    var status = requireEnum_(payload.accountStatus, 'Account status', ['ACTIVE', 'INACTIVE']);
    if (String(auth.user['User ID']) === userId && status === STATUS.INACTIVE) {
      throw appError_(ERR.CONFLICT, 'You cannot deactivate your own account.');
    }
    var store = readTable_('USERS', CONFIG.SHEETS.USERS);
    var row = findById_(store.rows, 'User ID', userId);
    if (!row) throw appError_(ERR.NOT_FOUND, 'That account does not exist.');
    assertCanManageTarget_(actorRole, row, 'deactivate');
    updateRecord_(store.sheet, store.headers, row._row, {
      'Account status': status,
      'Updated at': new Date().toISOString(),
    });
    if (status === STATUS.INACTIVE) {
      // Invalidate every live session for the deactivated account.
      var sessions = readTable_('SESSIONS', CONFIG.SHEETS.SESSIONS);
      sessions.rows.forEach(function (sessionRow) {
        if (String(sessionRow['User ID']) === userId) {
          updateRecord_(sessions.sheet, sessions.headers, sessionRow._row, { Revoked: 'TRUE' });
        }
      });
    }
    logActivity_(
      String(auth.user['User ID']),
      'user.status',
      'user',
      userId,
      (status === STATUS.ACTIVE ? 'Activated ' : 'Deactivated ') + String(row.Name),
    );
    return { user: publicUser_(Object.assign({}, row, { 'Account status': status })) };
  });
}

/** Self-service profile edit: name, phone and department only. */
function updateOwnProfile_(auth, payload) {
  return withLock_(function () {
    var store = readTable_('USERS', CONFIG.SHEETS.USERS);
    var row = auth.user;
    var fields = {
      Name: requireString_(payload.name, 'Name', 2, 120),
      Phone: optionalString_(payload.phone, 30),
      Department: optionalString_(payload.department, 120),
      'Updated at': new Date().toISOString(),
    };
    updateRecord_(store.sheet, store.headers, row._row, fields);
    logActivity_(String(row['User ID']), 'user.profile', 'user', String(row['User ID']), 'Updated own profile');
    return { user: publicUser_(Object.assign({}, row, fields)) };
  });
}

/** ADMIN recovery: set a temporary password for a user (never returns the hash). */
function resetUserPassword_(auth, payload) {
  var actorRole = requireRole_(auth, [ROLES.ADMIN, ROLES.LIBRARIAN]);
  return withLock_(function () {
    var userId = requireId_(payload.userId, 'User ID');
    var store = readTable_('USERS', CONFIG.SHEETS.USERS);
    var row = findById_(store.rows, 'User ID', userId);
    if (!row) throw appError_(ERR.NOT_FOUND, 'That account does not exist.');
    assertCanManageTarget_(actorRole, row, 'reset the password of');
    var password = requirePassword_(payload.newPassword);
    var salt = newSalt_();
    updateRecord_(store.sheet, store.headers, row._row, {
      'Password salt': salt,
      'Password hash': hashPassword_(password, salt, CONFIG.HASH_ITERATIONS),
      'Hash iterations': CONFIG.HASH_ITERATIONS,
      'Updated at': new Date().toISOString(),
    });
    logActivity_(
      String(auth.user['User ID']),
      'user.password_reset',
      'user',
      userId,
      'Reset password for ' + String(row.Name),
    );
    return { reset: true };
  });
}

/* ===================== SettingsService.gs ===================== */

/** SettingsService.gs — configurable library policy stored in the Settings tab. */
function readSettings_() {
  var store = readTable_('SETTINGS', CONFIG.SHEETS.SETTINGS);
  var settings = {};
  Object.keys(CONFIG.DEFAULT_SETTINGS).forEach(function (key) {
    settings[key] = CONFIG.DEFAULT_SETTINGS[key];
  });
  store.rows.forEach(function (row) {
    var key = String(row.Key || '').trim();
    if (key) settings[key] = String(row.Value === undefined ? '' : row.Value);
  });
  return { store: store, settings: settings };
}

function getSettings_(auth) {
  var result = readSettings_();
  return { settings: result.settings, editable: normaliseRole_(auth.user.Role) === ROLES.ADMIN };
}

function updateSettings_(auth, payload) {
  requireRole_(auth, [ROLES.ADMIN]);
  var patch = payload.settings || {};
  var allowed = Object.keys(CONFIG.DEFAULT_SETTINGS);
  var unknown = Object.keys(patch).filter(function (key) {
    return allowed.indexOf(key) === -1;
  });
  if (unknown.length) {
    throw appError_(ERR.VALIDATION, 'Unknown setting(s): ' + unknown.slice(0, 5).join(', '));
  }
  if (!Object.keys(patch).length) {
    throw appError_(ERR.VALIDATION, 'No settings were supplied.');
  }
  return withLock_(function () {
    var store = readSettings_();
    var now = new Date().toISOString();
    allowed.forEach(function (key) {
      if (!(key in patch)) return;
      var value = sanitizeText_(patch[key], 120);
      var existing = store.store.rows.filter(function (row) {
        return String(row.Key) === key;
      })[0];
      if (existing) {
        updateRecord_(store.store.sheet, store.store.headers, existing._row, { Value: value, 'Updated at': now });
      } else {
        appendRecord_(store.store.sheet, store.store.headers, { Key: key, Value: value, 'Updated at': now });
      }
    });
    logActivity_(String(auth.user['User ID']), 'settings.updated', 'settings', 'library', 'Updated library policy');
    return { settings: readSettings_().settings };
  });
}

/* ------------------------------------------------------------- policy helpers */

function settingNumber_(key) {
  var value = Number(readSettings_().settings[key]);
  return isFinite(value) && value >= 0 ? value : Number(CONFIG.DEFAULT_SETTINGS[key]) || 0;
}

function finePerDay_() {
  return settingNumber_('fine_per_day');
}

function borrowLimitFor_(user) {
  if (user['Borrowing limit'] !== '' && user['Borrowing limit'] !== undefined) {
    var custom = Number(user['Borrowing limit']);
    if (isFinite(custom)) return custom;
  }
  var role = normaliseRole_(user.Role);
  return role === ROLES.STUDENT ? settingNumber_('student_borrow_limit') : settingNumber_('faculty_borrow_limit');
}

function overdueDays_(dueDate) {
  var due = new Date(dueDate);
  if (isNaN(due.getTime())) return 0;
  var days = Math.floor((startOfDay_(new Date()).getTime() - startOfDay_(due).getTime()) / 86400000);
  return days > 0 ? days : 0;
}

function startOfDay_(date) {
  return new Date(date.getFullYear(), date.getMonth(), date.getDate());
}

function addDays_(date, days) {
  var next = new Date(date.getTime());
  next.setDate(next.getDate() + days);
  return next;
}

/* ===================== BooksService.gs ===================== */

/**
 * BooksService.gs — catalogue reads and writes.
 * Availability is always derived from active loans; the sheet's derived columns
 * are refreshed after every mutation so the spreadsheet never drifts.
 */
function loansForBook_(loans, bookId) {
  return loans.filter(function (loan) {
    var status = String(loan['Loan status'] || '').toUpperCase();
    return String(loan['Book ID']) === bookId && status === 'ACTIVE';
  });
}

function bookAvailability_(book, loans) {
  var total = Math.max(1, Number(book['Total copies']) || 1);
  var onLoan = loansForBook_(loans, String(book['Book ID'])).length;
  return { total: total, onLoan: onLoan, available: Math.max(0, total - onLoan) };
}

function mapBook_(book, loans) {
  var availability = bookAvailability_(book, loans);
  var isbn = String(book.ISBN || '');
  return {
    bookId: String(book['Book ID']),
    title: String(book.Title || ''),
    author: String(book.Author || ''),
    isbn: isbn,
    publisher: String(book.Publisher || ''),
    year: Number(book.Year) || 0,
    category: String(book.Category || 'General'),
    description: String(book.Description || ''),
    coverImageUrl: String(book['Cover image URL'] || ''),
    shelfLocation: String(book.Shelf || ''),
    totalCopies: availability.total,
    availableCopies: availability.available,
    copiesOnLoan: availability.onLoan,
    recordStatus: String(book.Status || 'ACTIVE').toUpperCase() === 'ARCHIVED' ? 'ARCHIVED' : 'ACTIVE',
    createdAt: String(book['Created at'] || book.Added || ''),
    updatedAt: String(book['Updated at'] || ''),
  };
}

function listBooks_(params) {
  var store = readTable_('BOOKS', CONFIG.SHEETS.BOOKS);
  var loans = readTable_('LOANS', CONFIG.SHEETS.LOANS).rows;
  var books = store.rows
    .map(function (book) {
      return mapBook_(book, loans);
    })
    .filter(function (book) {
      return Boolean(book.bookId) && Boolean(book.title);
    });
  return { books: books, total: books.length };
}

/**
 * Public, unauthenticated catalogue read — the one action that answers without a session.
 *
 * It exists because the marketing site and /catalog are public pages: before this, a signed-out
 * visitor saw an empty catalogue and four zeroes, which looked broken.
 *
 * What it deliberately does NOT return: member names, emails, IDs, loans, reservations, fines,
 * activity, settings. Only title-level fields that are printed on a book's spine anyway, plus
 * three aggregate counters. Archived titles are hidden.
 */
function publicCatalogue_(params) {
  var payload = params || {};
  var books = listBooks_({}).books.filter(function (book) {
    return book.recordStatus === 'ACTIVE';
  });

  var search = payload.search ? sanitizeText_(payload.search, 80).toLowerCase() : '';
  if (search) {
    books = books.filter(function (book) {
      var haystack = [book.title, book.author, book.category, book.isbn].join(' ').toLowerCase();
      return haystack.indexOf(search) !== -1;
    });
  }

  var category = payload.category ? sanitizeText_(payload.category, 80).toLowerCase() : '';
  if (category && category !== 'all') {
    books = books.filter(function (book) {
      return String(book.category).toLowerCase() === category;
    });
  }

  var all = listBooks_({}).books.filter(function (book) {
    return book.recordStatus === 'ACTIVE';
  });
  var copies = 0;
  var available = 0;
  var onLoan = 0;
  (all || []).forEach(function (book) {
    copies += Number(book.totalCopies) || 0;
    available += Number(book.availableCopies) || 0;
    onLoan += Number(book.copiesOnLoan) || 0;
  });

  var users = readTable_('USERS', CONFIG.SHEETS.USERS).rows.filter(function (row) {
    return String(row['Account status'] || '').toUpperCase() !== 'INACTIVE';
  });

  return {
    books: books,
    total: books.length,
    stats: {
      titles: all.length,
      copies: copies,
      available: available,
      onLoan: onLoan,
      members: users.length,
    },
    serverTime: new Date().toISOString(),
  };
}

function getBook_(params) {
  var bookId = requireId_(params.bookId, 'Book ID');
  var store = readTable_('BOOKS', CONFIG.SHEETS.BOOKS);
  var loans = readTable_('LOANS', CONFIG.SHEETS.LOANS).rows;
  var row = findById_(store.rows, 'Book ID', bookId);
  if (!row) throw appError_(ERR.NOT_FOUND, 'That book does not exist.');
  return { book: mapBook_(row, loans) };
}

function validateBookPayload_(payload) {
  return {
    Title: requireString_(payload.title, 'Title', 1, 300),
    Author: requireString_(payload.author, 'Author', 1, 200),
    ISBN: optionalString_(payload.isbn, 40),
    Publisher: optionalString_(payload.publisher, 160),
    Year: payload.year === '' || payload.year === undefined ? '' : requireInt_(payload.year, 'Year', 1400, 2100),
    Category: optionalString_(payload.category, 80) || 'General',
    Shelf: optionalString_(payload.shelf, 40),
    'Total copies': requireInt_(payload.totalCopies, 'Total copies', 1, 999),
    Description: optionalString_(payload.description, 2000),
    'Cover image URL': optionalString_(payload.coverImageUrl, 500),
  };
}

function createBook_(auth, payload) {
  requireRole_(auth, [ROLES.ADMIN, ROLES.LIBRARIAN]);
  return withLock_(function () {
    var store = readTable_('BOOKS', CONFIG.SHEETS.BOOKS);
    var fields = validateBookPayload_(payload);
    var duplicate = store.rows.some(function (row) {
      var sameTitle = String(row.Title || '').toLowerCase() === fields.Title.toLowerCase();
      var sameIsbn = fields.ISBN && String(row.ISBN || '') === fields.ISBN;
      return sameTitle || sameIsbn;
    });
    if (duplicate) {
      throw appError_(ERR.CONFLICT, 'A book with that title or ISBN already exists.');
    }
    var now = new Date().toISOString();
    var record = {};
    Object.keys(fields).forEach(function (key) {
      record[key] = fields[key];
    });
    record['Book ID'] = nextId_('BK', store.rows, 'Book ID');
    record.Status = 'ACTIVE';
    record.Added = now;
    record['Created at'] = now;
    record['Updated at'] = now;
    record['Copies on loan'] = 0;
    record['Available copies'] = fields['Total copies'];
    appendRecord_(store.sheet, store.headers, record);
    logActivity_(
      String(auth.user['User ID']),
      'book.created',
      'book',
      record['Book ID'],
      'Added "' + fields.Title + '" (' + fields['Total copies'] + ' copies)',
    );
    return { book: mapBook_(record, []) };
  });
}

function updateBook_(auth, payload) {
  requireRole_(auth, [ROLES.ADMIN, ROLES.LIBRARIAN]);
  return withLock_(function () {
    var bookId = requireId_(payload.bookId, 'Book ID');
    var store = readTable_('BOOKS', CONFIG.SHEETS.BOOKS);
    var row = findById_(store.rows, 'Book ID', bookId);
    if (!row) throw appError_(ERR.NOT_FOUND, 'That book does not exist.');
    var fields = validateBookPayload_(payload);
    var loans = readTable_('LOANS', CONFIG.SHEETS.LOANS).rows;
    var active = loansForBook_(loans, bookId).length;
    if (fields['Total copies'] < active) {
      throw appError_(
        ERR.CONFLICT,
        'Total copies cannot be below the ' + active + ' copies currently on loan. Process returns first.',
      );
    }
    fields['Updated at'] = new Date().toISOString();
    updateRecord_(store.sheet, store.headers, row._row, fields);
    refreshBookDerived_(store, loans);
    logActivity_(String(auth.user['User ID']), 'book.updated', 'book', bookId, 'Updated "' + fields.Title + '"');
    return { book: mapBook_(Object.assign({}, row, fields), loans) };
  });
}

function archiveBook_(auth, payload) {
  requireRole_(auth, [ROLES.ADMIN, ROLES.LIBRARIAN]);
  return withLock_(function () {
    var bookId = requireId_(payload.bookId, 'Book ID');
    var archived = payload.archived !== false;
    var store = readTable_('BOOKS', CONFIG.SHEETS.BOOKS);
    var row = findById_(store.rows, 'Book ID', bookId);
    if (!row) throw appError_(ERR.NOT_FOUND, 'That book does not exist.');
    updateRecord_(store.sheet, store.headers, row._row, {
      Status: archived ? 'ARCHIVED' : 'ACTIVE',
      'Updated at': new Date().toISOString(),
    });
    logActivity_(
      String(auth.user['User ID']),
      archived ? 'book.archived' : 'book.restored',
      'book',
      bookId,
      (archived ? 'Archived "' : 'Restored "') + String(row.Title) + '"',
    );
    return { book: mapBook_(Object.assign({}, row, { Status: archived ? 'ARCHIVED' : 'ACTIVE' }), []) };
  });
}

/** Recompute the derived columns for every book so the sheet never drifts. */
function refreshBookDerived_(store, loans) {
  var rows = store.rows;
  if (!rows.length) return;
  var headerRow = columnMap_(store.headers);
  writeColumn_(store.sheet, rows, 'Copies on loan', headerRow, function (row) {
    return bookAvailability_(row, loans).onLoan;
  });
  writeColumn_(store.sheet, rows, 'Available copies', headerRow, function (row) {
    return bookAvailability_(row, loans).available;
  });
}

/**
 * Permanently delete a catalogue row — only when it has no circulation history.
 * Titles that were ever borrowed or reserved must be archived instead so the
 * Loans/Reservations tabs never point at a missing book.
 */
function deleteBook_(auth, payload) {
  requireRole_(auth, [ROLES.ADMIN]);
  return withLock_(function () {
    var bookId = requireId_(payload.bookId, 'Book ID');
    var store = readTable_('BOOKS', CONFIG.SHEETS.BOOKS);
    var row = findById_(store.rows, 'Book ID', bookId);
    if (!row) throw appError_(ERR.NOT_FOUND, 'That book does not exist.');

    var loans = readTable_('LOANS', CONFIG.SHEETS.LOANS).rows.filter(function (loan) {
      return String(loan['Book ID']) === bookId;
    });
    if (loans.length) {
      throw appError_(
        ERR.CONFLICT,
        'This title has circulation history (' +
          loans.length +
          ' loan record(s)), so it cannot be deleted. Archive it instead to keep the records consistent.',
      );
    }
    // Only holds that are still open block deletion; cancelled/expired rows are history.
    var openReservations = readTable_('RESERVATIONS', CONFIG.SHEETS.RESERVATIONS).rows.filter(function (reservation) {
      var status = String(reservation['Reservation status'] || '').toUpperCase();
      return String(reservation['Book ID']) === bookId && (status === 'PENDING' || status === 'READY');
    });
    if (openReservations.length) {
      throw appError_(
        ERR.CONFLICT,
        'This title still has ' + openReservations.length + ' open reservation(s). Cancel them before deleting.',
      );
    }

    deleteRow_(store.sheet, row._row);
    logActivity_(
      String(auth.user['User ID']),
      'book.deleted',
      'book',
      bookId,
      'Deleted "' + String(row.Title) + '" (no circulation history)',
    );
    return { deleted: true, bookId: bookId };
  });
}

/* ===================== LoansService.gs ===================== */

/**
 * LoansService.gs — issue, return, renew.
 * Circulation runs inside withLock_ and re-reads state, so two concurrent
 * issues can never oversell the last copy, and a loan can never be returned twice.
 */
function mapLoan_(loan, booksById, usersById) {
  var book = booksById[String(loan['Book ID'])] || {};
  var user = usersById[String(loan['User ID'])] || {};
  var status = String(loan['Loan status'] || '').toUpperCase() === 'RETURNED' ? 'RETURNED' : 'ACTIVE';
  var fine = Number(loan['Fine amount']) || 0;
  if (status === 'ACTIVE') fine = overdueDays_(loan['Due date']) * finePerDay_();
  return {
    loanId: String(loan['Loan ID']),
    bookId: String(loan['Book ID']),
    bookTitle: book.title || '',
    userId: String(loan['User ID']),
    userName: user.name || '',
    issuedBy: String(loan['Issued by'] || ''),
    issueDate: String(loan['Issue date'] || ''),
    dueDate: String(loan['Due date'] || ''),
    returnDate: loan['Return date'] ? String(loan['Return date']) : null,
    loanStatus: status,
    renewalCount: Number(loan['Renewal count']) || 0,
    fineAmount: fine,
    overdueDays: status === 'ACTIVE' ? overdueDays_(loan['Due date']) : 0,
    createdAt: String(loan['Created at'] || ''),
    updatedAt: String(loan['Updated at'] || ''),
  };
}

function loanContext_() {
  var books = readTable_('BOOKS', CONFIG.SHEETS.BOOKS).rows;
  var users = readTable_('USERS', CONFIG.SHEETS.USERS).rows;
  var loans = readTable_('LOANS', CONFIG.SHEETS.LOANS).rows;
  var booksById = {};
  books.forEach(function (book) {
    booksById[String(book['Book ID'])] = mapBook_(book, loans);
  });
  var usersById = {};
  users.forEach(function (user) {
    usersById[String(user['User ID'])] = publicUser_(user);
  });
  return { books: books, users: users, loans: loans, booksById: booksById, usersById: usersById };
}

function listLoans_(auth, params) {
  var role = normaliseRole_(auth.user.Role);
  var context = loanContext_();
  var rows = context.loans.filter(function (loan) {
    if (isStaff_(role)) return true;
    return String(loan['User ID']) === String(auth.user['User ID']);
  });
  if (params && params.status && String(params.status).toUpperCase() !== 'ALL') {
    var wanted = String(params.status).toUpperCase();
    rows = rows.filter(function (loan) {
      return String(loan['Loan status'] || '').toUpperCase() === wanted;
    });
  }
  var loans = rows.map(function (loan) {
    return mapLoan_(loan, context.booksById, context.usersById);
  });
  return { loans: loans, total: loans.length, scope: isStaff_(role) ? 'ALL' : 'SELF' };
}

function activeLoansForUser_(loans, userId) {
  return loans.filter(function (loan) {
    return String(loan['User ID']) === userId && String(loan['Loan status']).toUpperCase() === 'ACTIVE';
  });
}

function unpaidFinesForUser_(loans, userId) {
  return loans.reduce(function (sum, loan) {
    if (String(loan['User ID']) !== userId) return sum;
    var status = String(loan['Loan status']).toUpperCase();
    if (status === 'ACTIVE') return sum + overdueDays_(loan['Due date']) * finePerDay_();
    if (status === 'RETURNED') return sum + (Number(loan['Fine amount']) || 0);
    return sum;
  }, 0);
}

/**
 * Issue a copy. ADMIN issues for anyone; FACULTY/STUDENT may self-issue only when
 * the policy setting allows it, and only for themselves.
 */
function issueLoan_(auth, payload) {
  var role = normaliseRole_(auth.user.Role);
  var selfId = String(auth.user['User ID']);
  var targetUserId = payload.userId ? requireId_(payload.userId, 'User ID') : selfId;
  if (!isStaff_(role) && targetUserId !== selfId) {
    throw appError_(ERR.FORBIDDEN, 'You can only borrow books for your own account.');
  }
  if (!isStaff_(role) && String(readSettings_().settings.allow_self_checkout) !== 'true') {
    throw appError_(ERR.FORBIDDEN, 'Self checkout is disabled. Ask library staff to issue this book.');
  }

  return withLock_(function () {
    var context = loanContext_();
    var bookId = requireId_(payload.bookId, 'Book ID');
    var bookRow = findById_(context.books, 'Book ID', bookId);
    if (!bookRow) throw appError_(ERR.NOT_FOUND, 'That book does not exist.');
    var userRow = findById_(context.users, 'User ID', targetUserId);
    if (!userRow) throw appError_(ERR.NOT_FOUND, 'That member does not exist.');
    if (String(userRow['Account status']).toUpperCase() !== STATUS.ACTIVE) {
      throw appError_(ERR.FORBIDDEN, 'This account is deactivated and cannot borrow.');
    }
    if (String(bookRow.Status || 'ACTIVE').toUpperCase() === 'ARCHIVED') {
      throw appError_(ERR.CONFLICT, 'That title is archived and cannot be issued.');
    }

    var availability = bookAvailability_(bookRow, context.loans);
    if (availability.available < 1) {
      throw appError_(ERR.CONFLICT, 'No copies are available. Place a reservation instead.');
    }

    var existing = activeLoansForUser_(context.loans, targetUserId);
    var duplicate = existing.filter(function (loan) {
      return String(loan['Book ID']) === bookId;
    }).length;
    if (duplicate > 0) {
      throw appError_(ERR.CONFLICT, 'This member already has a copy of that title on loan.');
    }
    var limit = borrowLimitFor_(userRow);
    if (existing.length >= limit) {
      throw appError_(ERR.CONFLICT, 'Borrowing limit reached (' + limit + ' books). Return a book first.');
    }

    var settings = readSettings_().settings;
    if (String(settings.block_issue_on_unpaid_fines) === 'true') {
      var fines = unpaidFinesForUser_(context.loans, targetUserId);
      if (fines >= Number(settings.fine_block_threshold || 0)) {
        throw appError_(ERR.CONFLICT, 'Unpaid simulated fines of ₹' + fines + ' block new loans.');
      }
    }

    var store = readTable_('LOANS', CONFIG.SHEETS.LOANS);
    var now = new Date();
    var dueDays = settingNumber_('loan_duration_days') || 14;
    var record = {
      'Loan ID': nextId_('LN', store.rows, 'Loan ID'),
      'Book ID': bookId,
      'User ID': targetUserId,
      'Issued by': isStaff_(role) ? String(auth.user['User ID']) : targetUserId,
      'Issue date': now.toISOString(),
      'Due date': addDays_(now, dueDays).toISOString(),
      'Return date': '',
      'Loan status': 'ACTIVE',
      'Renewal count': 0,
      'Fine amount': '',
      'Created at': now.toISOString(),
      'Updated at': now.toISOString(),
    };
    appendRecord_(store.sheet, store.headers, record);

    var bookStore = readTable_('BOOKS', CONFIG.SHEETS.BOOKS);
    refreshBookDerived_(bookStore, readTable_('LOANS', CONFIG.SHEETS.LOANS).rows);

    logActivity_(
      String(auth.user['User ID']),
      'loan.issued',
      'loan',
      record['Loan ID'],
      'Issued "' + String(bookRow.Title) + '" to ' + String(userRow.Name),
    );
    // Join the title and member name: the UI renders this response immediately, so an
    // empty context would show a loan with no title.
    var booksById = {};
    booksById[bookId] = mapBook_(bookRow, context.loans.concat([record]));
    var usersById = {};
    usersById[targetUserId] = publicUser_(userRow);
    return { loan: mapLoan_(record, booksById, usersById) };
  });
}

function returnLoan_(auth, payload) {
  var role = normaliseRole_(auth.user.Role);
  if (!isStaff_(role)) {
    throw appError_(ERR.FORBIDDEN, 'Only library staff can process returns.');
  }
  return withLock_(function () {
    var loanId = requireId_(payload.loanId, 'Loan ID');
    var store = readTable_('LOANS', CONFIG.SHEETS.LOANS);
    var loan = findById_(store.rows, 'Loan ID', loanId);
    if (!loan) throw appError_(ERR.NOT_FOUND, 'That loan does not exist.');
    if (String(loan['Loan status']).toUpperCase() === 'RETURNED') {
      throw appError_(ERR.CONFLICT, 'This loan was already returned.');
    }
    var now = new Date();
    var daysLate = overdueDays_(loan['Due date']);
    var fine = daysLate * finePerDay_();
    updateRecord_(store.sheet, store.headers, loan._row, {
      'Return date': now.toISOString(),
      'Loan status': 'RETURNED',
      'Fine amount': fine,
      'Updated at': now.toISOString(),
    });
    var bookStore = readTable_('BOOKS', CONFIG.SHEETS.BOOKS);
    refreshBookDerived_(bookStore, readTable_('LOANS', CONFIG.SHEETS.LOANS).rows);
    var book = findById_(bookStore.rows, 'Book ID', String(loan['Book ID']));
    logActivity_(
      String(auth.user['User ID']),
      'loan.returned',
      'loan',
      loanId,
      'Returned "' + String(book ? book.Title : 'title') + '"' + (fine > 0 ? ' with ₹' + fine + ' simulated fine' : ''),
    );
    var context = loanContext_();
    return {
      loan: mapLoan_(
        Object.assign({}, loan, { 'Loan status': 'RETURNED', 'Fine amount': fine }),
        context.booksById,
        context.usersById,
      ),
      fine: fine,
      daysLate: daysLate,
    };
  });
}

function renewLoan_(auth, payload) {
  var role = normaliseRole_(auth.user.Role);
  return withLock_(function () {
    var loanId = requireId_(payload.loanId, 'Loan ID');
    var store = readTable_('LOANS', CONFIG.SHEETS.LOANS);
    var loan = findById_(store.rows, 'Loan ID', loanId);
    if (!loan) throw appError_(ERR.NOT_FOUND, 'That loan does not exist.');
    var owner = String(loan['User ID']) === String(auth.user['User ID']);
    if (!owner && !isStaff_(role)) {
      throw appError_(ERR.FORBIDDEN, 'You can only renew your own loans.');
    }
    if (String(loan['Loan status']).toUpperCase() === 'RETURNED') {
      throw appError_(ERR.CONFLICT, 'A returned loan cannot be renewed.');
    }
    if (overdueDays_(loan['Due date']) > 0) {
      throw appError_(ERR.CONFLICT, 'Overdue loans cannot be renewed. Return the book first.');
    }
    var maxRenewals = settingNumber_('max_renewals');
    var renewals = Number(loan['Renewal count']) || 0;
    if (renewals >= maxRenewals) {
      throw appError_(ERR.CONFLICT, 'Renewal limit reached (' + maxRenewals + ').');
    }
    var extensionDays = settingNumber_('renewal_extension_days') || 14;
    var newDue = addDays_(new Date(loan['Due date']), extensionDays);
    // Do not push the due date past an active reservation held by someone else.
    var reservations = readTable_('RESERVATIONS', CONFIG.SHEETS.RESERVATIONS).rows.filter(function (row) {
      var status = String(row['Reservation status'] || '').toUpperCase();
      return String(row['Book ID']) === String(loan['Book ID']) && (status === 'PENDING' || status === 'READY');
    });
    if (reservations.length > 0) {
      throw appError_(ERR.CONFLICT, 'Another member is waiting for this title, so it cannot be renewed.');
    }
    updateRecord_(store.sheet, store.headers, loan._row, {
      'Due date': newDue.toISOString(),
      'Renewal count': renewals + 1,
      'Updated at': new Date().toISOString(),
    });
    logActivity_(String(auth.user['User ID']), 'loan.renewed', 'loan', loanId, 'Renewed a loan until ' + newDue.toISOString().slice(0, 10));
    var context = loanContext_();
    return {
      loan: mapLoan_(
        Object.assign({}, loan, { 'Due date': newDue.toISOString(), 'Renewal count': renewals + 1 }),
        context.booksById,
        context.usersById,
      ),
    };
  });
}

/* ===================== ReservationsService.gs ===================== */

/**
 * ReservationsService.gs — holds with queue positions, expiry and duplicate prevention.
 * Status policy: PENDING → READY (a copy released) → FULFILLED | CANCELLED | EXPIRED.
 */
function mapReservation_(reservation, booksById, usersById) {
  var status = String(reservation['Reservation status'] || 'PENDING').toUpperCase();
  return {
    reservationId: String(reservation['Reservation ID']),
    bookId: String(reservation['Book ID']),
    bookTitle: booksById[String(reservation['Book ID'])] || '',
    userId: String(reservation['User ID']),
    userName: usersById[String(reservation['User ID'])] || '',
    reservationDate: String(reservation['Reservation date'] || ''),
    queuePosition: Number(reservation['Queue position']) || 0,
    reservationStatus: status,
    expiryDate: reservation['Expiry date'] ? String(reservation['Expiry date']) : null,
    createdAt: String(reservation['Created at'] || ''),
    updatedAt: String(reservation['Updated at'] || ''),
  };
}

function reservationContext_() {
  var books = readTable_('BOOKS', CONFIG.SHEETS.BOOKS).rows;
  var users = readTable_('USERS', CONFIG.SHEETS.USERS).rows;
  var booksById = {};
  books.forEach(function (book) {
    booksById[String(book['Book ID'])] = String(book.Title || '');
  });
  var usersById = {};
  users.forEach(function (user) {
    usersById[String(user['User ID'])] = String(user.Name || '');
  });
  return { booksById: booksById, usersById: usersById };
}

function listReservations_(auth, params) {
  var role = normaliseRole_(auth.user.Role);
  var context = reservationContext_();
  var store = readTable_('RESERVATIONS', CONFIG.SHEETS.RESERVATIONS);
  var rows = store.rows.filter(function (row) {
    if (isStaff_(role)) return true;
    return String(row['User ID']) === String(auth.user['User ID']);
  });
  var reservations = rows.map(function (row) {
    return mapReservation_(row, context.booksById, context.usersById);
  });
  return { reservations: reservations, total: reservations.length, scope: isStaff_(role) ? 'ALL' : 'SELF' };
}

function createReservation_(auth, payload) {
  var role = normaliseRole_(auth.user.Role);
  var selfId = String(auth.user['User ID']);
  var targetUserId = payload.userId ? requireId_(payload.userId, 'User ID') : selfId;
  if (!isStaff_(role) && targetUserId !== selfId) {
    throw appError_(ERR.FORBIDDEN, 'You can only reserve books for your own account.');
  }
  return withLock_(function () {
    var bookId = requireId_(payload.bookId, 'Book ID');
    var books = readTable_('BOOKS', CONFIG.SHEETS.BOOKS);
    var book = findById_(books.rows, 'Book ID', bookId);
    if (!book) throw appError_(ERR.NOT_FOUND, 'That book does not exist.');
    if (String(book.Status || 'ACTIVE').toUpperCase() === 'ARCHIVED') {
      throw appError_(ERR.CONFLICT, 'That title is archived and cannot be reserved.');
    }
    var users = readTable_('USERS', CONFIG.SHEETS.USERS).rows;
    var user = findById_(users, 'User ID', targetUserId);
    if (!user) throw appError_(ERR.NOT_FOUND, 'That member does not exist.');
    if (String(user['Account status']).toUpperCase() !== STATUS.ACTIVE) {
      throw appError_(ERR.FORBIDDEN, 'This account is deactivated.');
    }

    var store = readTable_('RESERVATIONS', CONFIG.SHEETS.RESERVATIONS);
    var active = store.rows.filter(function (row) {
      var status = String(row['Reservation status'] || '').toUpperCase();
      return String(row['Book ID']) === bookId && (status === 'PENDING' || status === 'READY');
    });
    var duplicate = active.filter(function (row) {
      return String(row['User ID']) === targetUserId;
    }).length;
    if (duplicate > 0) {
      throw appError_(ERR.CONFLICT, 'You already have an active reservation for this title.');
    }

    var loans = readTable_('LOANS', CONFIG.SHEETS.LOANS).rows;
    var mine = loans.filter(function (loan) {
      return String(loan['Book ID']) === bookId && String(loan['User ID']) === targetUserId && String(loan['Loan status']).toUpperCase() === 'ACTIVE';
    }).length;
    if (mine > 0) {
      throw appError_(ERR.CONFLICT, 'You already have this title on loan.');
    }

    var now = new Date();
    var record = {
      'Reservation ID': nextId_('RS', store.rows, 'Reservation ID'),
      'Book ID': bookId,
      'User ID': targetUserId,
      'Reservation date': now.toISOString(),
      'Queue position': active.length + 1,
      'Reservation status': 'PENDING',
      'Expiry date': '',
      'Created at': now.toISOString(),
      'Updated at': now.toISOString(),
    };
    appendRecord_(store.sheet, store.headers, record);
    logActivity_(
      String(auth.user['User ID']),
      'reservation.created',
      'reservation',
      record['Reservation ID'],
      'Reserved "' + String(book.Title) + '" (queue #' + record['Queue position'] + ')',
    );
    // Pass the joined names: the client renders the title straight from this response,
    // so an empty lookup map would show a nameless hold in the UI.
    var booksById = {};
    booksById[bookId] = String(book.Title || '');
    var usersById = {};
    usersById[targetUserId] = String(user.Name || '');
    return { reservation: mapReservation_(record, booksById, usersById) };
  });
}

function cancelReservation_(auth, payload) {
  var role = normaliseRole_(auth.user.Role);
  return withLock_(function () {
    var reservationId = requireId_(payload.reservationId, 'Reservation ID');
    var store = readTable_('RESERVATIONS', CONFIG.SHEETS.RESERVATIONS);
    var row = findById_(store.rows, 'Reservation ID', reservationId);
    if (!row) throw appError_(ERR.NOT_FOUND, 'That reservation does not exist.');
    var owner = String(row['User ID']) === String(auth.user['User ID']);
    if (!owner && !isStaff_(role)) {
      throw appError_(ERR.FORBIDDEN, 'You can only cancel your own reservations.');
    }
    var status = String(row['Reservation status'] || '').toUpperCase();
    if (status === 'CANCELLED' || status === 'FULFILLED' || status === 'EXPIRED') {
      throw appError_(ERR.CONFLICT, 'This reservation is already closed.');
    }
    updateRecord_(store.sheet, store.headers, row._row, {
      'Reservation status': 'CANCELLED',
      'Queue position': 0,
      'Updated at': new Date().toISOString(),
    });
    requeue_(String(row['Book ID']));
    logActivity_(String(auth.user['User ID']), 'reservation.cancelled', 'reservation', reservationId, 'Cancelled a reservation');
    var context = reservationContext_();
    return {
      reservation: mapReservation_(Object.assign({}, row, { 'Reservation status': 'CANCELLED' }), context.booksById, context.usersById),
    };
  });
}

/** Recompute queue positions for a title after any change. */
function requeue_(bookId) {
  var store = readTable_('RESERVATIONS', CONFIG.SHEETS.RESERVATIONS);
  var waiting = store.rows
    .filter(function (row) {
      return String(row['Book ID']) === bookId && String(row['Reservation status'] || '').toUpperCase() === 'PENDING';
    })
    .sort(function (a, b) {
      return new Date(a['Reservation date']).getTime() - new Date(b['Reservation date']).getTime();
    });
  waiting.forEach(function (row, index) {
    updateRecord_(store.sheet, store.headers, row._row, { 'Queue position': index + 1 });
  });
}

/* ===================== WishlistService.gs ===================== */

/** WishlistService.gs — a member's personal saved titles (self-service only). */
function listWishlist_(auth) {
  var store = readTable_('WISHLISTS', CONFIG.SHEETS.WISHLISTS);
  var rows = store.rows.filter(function (row) {
    return String(row['User ID']) === String(auth.user['User ID']);
  });
  return {
    wishlist: rows.map(function (row) {
      return { bookId: String(row['Book ID']), createdAt: String(row['Created at'] || '') };
    }),
  };
}

function toggleWishlist_(auth, payload) {
  var bookId = requireId_(payload.bookId, 'Book ID');
  var userId = String(auth.user['User ID']);
  return withLock_(function () {
    var books = readTable_('BOOKS', CONFIG.SHEETS.BOOKS);
    if (!findById_(books.rows, 'Book ID', bookId)) throw appError_(ERR.NOT_FOUND, 'That book does not exist.');
    var store = readTable_('WISHLISTS', CONFIG.SHEETS.WISHLISTS);
    var existing = store.rows.filter(function (row) {
      return String(row['User ID']) === userId && String(row['Book ID']) === bookId;
    })[0];
    if (existing) {
      store.sheet.deleteRow(existing._row);
      return { bookId: bookId, saved: false };
    }
    appendRecord_(store.sheet, store.headers, {
      'User ID': userId,
      'Book ID': bookId,
      'Created at': new Date().toISOString(),
    });
    return { bookId: bookId, saved: true };
  });
}

/* ===================== ReportsService.gs ===================== */

/** ReportsService.gs — dashboard statistics and date-ranged analytics. */
function dashboardStats_(auth) {
  var role = normaliseRole_(auth.user.Role);
  var context = loanContext_();
  var reservations = readTable_('RESERVATIONS', CONFIG.SHEETS.RESERVATIONS).rows;

  var mine = {
    activeLoans: activeLoansForUser_(context.loans, String(auth.user['User ID'])),
    holds: reservations.filter(function (row) {
      var status = String(row['Reservation status'] || '').toUpperCase();
      return String(row['User ID']) === String(auth.user['User ID']) && (status === 'PENDING' || status === 'READY');
    }),
  };

  var books = context.books.filter(function (book) {
    return String(book.Title || '').trim() !== '' && String(book['Book ID'] || '').trim() !== '';
  });
  var totalCopies = books.reduce(function (sum, book) {
    return sum + Math.max(1, Number(book['Total copies']) || 1);
  }, 0);
  var onLoan = context.loans.filter(function (loan) {
    return String(loan['Loan status']).toUpperCase() === 'ACTIVE';
  }).length;
  var users = context.users.filter(function (user) {
    return String(user['User ID'] || '').trim() !== '';
  });

  var stats = {
    scope: isStaff_(role) ? 'LIBRARY' : 'SELF',
    totals: {
      titles: books.length,
      copies: totalCopies,
      availableCopies: Math.max(0, totalCopies - onLoan),
      members: users.length,
      students: users.filter(function (u) { return normaliseRole_(u.Role) === ROLES.STUDENT; }).length,
      faculty: users.filter(function (u) { return normaliseRole_(u.Role) === ROLES.FACULTY; }).length,
      admins: users.filter(function (u) { return normaliseRole_(u.Role) === ROLES.ADMIN; }).length,
      activeLoans: onLoan,
      overdue: context.loans.filter(function (loan) {
        return String(loan['Loan status']).toUpperCase() === 'ACTIVE' && overdueDays_(loan['Due date']) > 0;
      }).length,
      activeHolds: reservations.filter(function (row) {
        var status = String(row['Reservation status'] || '').toUpperCase();
        return status === 'PENDING' || status === 'READY';
      }).length,
      simulatedFines: context.loans.reduce(function (sum, loan) {
        var status = String(loan['Loan status']).toUpperCase();
        if (status === 'ACTIVE') return sum + overdueDays_(loan['Due date']) * finePerDay_();
        return sum + (status === 'RETURNED' ? Number(loan['Fine amount']) || 0 : 0);
      }, 0),
    },
    mine: {
      activeLoans: mine.activeLoans.length,
      overdue: mine.activeLoans.filter(function (loan) { return overdueDays_(loan['Due date']) > 0; }).length,
      holds: mine.holds.length,
      simulatedFines: unpaidFinesForUser_(context.loans, String(auth.user['User ID'])),
      borrowLimit: borrowLimitFor_(auth.user),
    },
  };
  return stats;
}

/**
 * Analytics over an inclusive date range.
 * Non-staff callers only ever see their own circulation, never library totals.
 */
function analytics_(auth, params) {
  var role = normaliseRole_(auth.user.Role);
  var staff = isStaff_(role);
  var from = params && params.from ? parseIsoDate_(params.from, 'From date') : addDays_(new Date(), -180);
  var to = params && params.to ? parseIsoDate_(params.to, 'To date') : new Date();
  if (from > to) throw appError_(ERR.VALIDATION, 'The start date must be before the end date.');

  var context = loanContext_();
  var scoped = context.loans.filter(function (loan) {
    if (!staff && String(loan['User ID']) !== String(auth.user['User ID'])) return false;
    var issued = new Date(loan['Issue date']);
    return !isNaN(issued.getTime()) && issued >= from && issued <= to;
  });
  if (!staff) {
    return {
      scope: 'SELF',
      range: { from: from.toISOString(), to: to.toISOString() },
      issued: scoped.length,
      returned: scoped.filter(function (l) { return String(l['Loan status']).toUpperCase() === 'RETURNED'; }).length,
      series: [],
      categories: [],
      topBooks: [],
    };
  }

  var byMonth = {};
  var byCategory = {};
  scoped.forEach(function (loan) {
    var issued = new Date(loan['Issue date']);
    var key = issued.getUTCFullYear() + '-' + String(issued.getUTCMonth() + 1).padStart(2, '0');
    byMonth[key] = byMonth[key] || { month: key, issued: 0, returned: 0 };
    byMonth[key].issued += 1;
    if (String(loan['Loan status']).toUpperCase() === 'RETURNED') byMonth[key].returned += 1;
    var book = context.booksById[String(loan['Book ID'])];
    var category = (book && book.category) || 'General';
    byCategory[category] = (byCategory[category] || 0) + 1;
  });

  var counts = {};
  scoped.forEach(function (loan) {
    var id = String(loan['Book ID']);
    counts[id] = (counts[id] || 0) + 1;
  });
  var topBooks = Object.keys(counts)
    .map(function (id) {
      var book = context.booksById[id];
      return { bookId: id, title: book ? book.title : id, author: book ? book.author : '', loans: counts[id] };
    })
    .sort(function (a, b) {
      return b.loans - a.loans;
    })
    .slice(0, 8);

  return {
    scope: 'LIBRARY',
    range: { from: from.toISOString(), to: to.toISOString() },
    issued: scoped.length,
    returned: scoped.filter(function (l) { return String(l['Loan status']).toUpperCase() === 'RETURNED'; }).length,
    series: Object.keys(byMonth)
      .sort()
      .map(function (key) {
        return byMonth[key];
      }),
    categories: Object.keys(byCategory)
      .map(function (key) {
        return { category: key, loans: byCategory[key] };
      })
      .sort(function (a, b) {
        return b.loans - a.loans;
      }),
    topBooks: topBooks,
  };
}

function listActivity_(auth, params) {
  var role = normaliseRole_(auth.user.Role);
  var store = readTable_('ACTIVITY', CONFIG.SHEETS.ACTIVITY);
  var limit = Math.min(Math.max(Number((params && params.limit) || 40), 1), 200);
  var rows = store.rows.filter(function (row) {
    if (isStaff_(role)) return true;
    return String(row['Actor user ID']) === String(auth.user['User ID']);
  });
  rows = rows
    .sort(function (a, b) {
      return new Date(b.Timestamp).getTime() - new Date(a.Timestamp).getTime();
    })
    .slice(0, limit);
  return {
    activity: rows.map(function (row) {
      return {
        activityId: String(row['Activity ID']),
        actorUserId: String(row['Actor user ID'] || ''),
        action: String(row.Action || ''),
        entityType: String(row['Entity type'] || ''),
        entityId: String(row['Entity ID'] || ''),
        timestamp: String(row.Timestamp || ''),
        summary: String(row.Summary || ''),
      };
    }),
  };
}

function logActivity_(actorId, action, entityType, entityId, summary) {
  try {
    var store = readTable_('ACTIVITY', CONFIG.SHEETS.ACTIVITY);
    appendRecord_(store.sheet, store.headers, {
      'Activity ID': nextId_('AC', store.rows, 'Activity ID'),
      'Actor user ID': actorId || 'SYSTEM',
      Action: action,
      'Entity type': entityType,
      'Entity ID': entityId,
      Timestamp: new Date().toISOString(),
      Summary: sanitizeText_(summary, 300),
    });
  } catch (err) {
    // Activity logging must never break the operation it is recording.
    try {
      console.error('Lumina activity log failed: ' + err.message);
    } catch (ignored) {}
  }
}

/* ===================== Setup.gs ===================== */

/**
 * Setup.gs — one-time initialisation and diagnostics.
 *
 * Run these three functions from the Apps Script editor (select the function in
 * the toolbar, press Run), in this order:
 *
 *   1. setupLumina()          → creates ONLY missing tabs/headers, seeds settings,
 *                               seeds one administrator when none exists.
 *   2. verifyLuminaSetup()    → read-only report: tabs, headers, counts, permissions.
 *   3. (deploy the Web app, then) runLuminaApiSelfTest() → end-to-end call through
 *                               the deployed URL using the seeded admin.
 *
 * Nothing here deletes, renames, reorders or clears existing data. A dry run is
 * available: setupLumina(true) reports what it *would* do without writing.
 */

function setupLumina(dryRun) {
  var dry = dryRun === true;
  var log = [];
  var book = spreadsheet_();
  log.push('Spreadsheet: "' + book.getName() + '" (' + book.getId() + ')');
  log.push('Existing tabs: ' + book.getSheets().map(function (s) { return s.getName(); }).join(', '));
  log.push(dry ? 'MODE: dry run — nothing will be written.' : 'MODE: apply changes (append-only).');

  /* 1. Tabs + headers ------------------------------------------------------ */
  Object.keys(CONFIG.SHEETS).forEach(function (kind) {
    var name = CONFIG.SHEETS[kind];
    var existing = findSheet_(kind, name);
    if (existing) {
      var before = readHeaderRow_(existing);
      var beforeKeys = before.map(headerKey_);
      var missing = CONFIG.HEADERS[kind].filter(function (header) {
        return beforeKeys.indexOf(headerKey_(header)) === -1;
      });
      if (missing.length === 0) {
        log.push('  ok      ' + kind + ' → tab "' + existing.getName() + '" (headers complete, ' + Math.max(0, existing.getLastRow() - 1) + ' rows)');
      } else {
        if (!dry) ensureHeaders_(existing, CONFIG.HEADERS[kind]);
        log.push(
          '  append  ' + kind + ' → tab "' + existing.getName() + '" gains columns: ' + missing.join(', ') +
            (dry ? ' (not applied)' : '') + ' — existing columns and rows untouched',
        );
      }
      return;
    }
    if (!dry) ensureSheet_(kind, name);
    log.push('  create  ' + kind + ' → tab "' + name + '"' + (dry ? ' (not applied)' : ''));
  });

  /* 2. Settings ----------------------------------------------------------- */
  // In a dry run nothing may be created — readTable_ would create the tab — so the
  // existing Settings rows are inspected directly when the tab already exists.
  var settingsSheet = findSheet_('SETTINGS', CONFIG.SHEETS.SETTINGS);
  var existingSettings = {};
  if (settingsSheet) {
    var settingsRows = readTable_('SETTINGS', CONFIG.SHEETS.SETTINGS).rows;
    settingsRows.forEach(function (row) {
      var key = String(row.Key || '').trim();
      if (key) existingSettings[key] = String(row.Value === undefined ? '' : row.Value);
    });
  }
  var missingSettings = Object.keys(CONFIG.DEFAULT_SETTINGS).filter(function (key) {
    return !(key in existingSettings) || existingSettings[key] === '';
  });
  if (!dry && settingsSheet) {
    var store = readSettings_();
    missingSettings.forEach(function (key) {
      appendRecord_(store.store.sheet, store.store.headers, {
        Key: key,
        Value: CONFIG.DEFAULT_SETTINGS[key],
        'Updated at': new Date().toISOString(),
      });
    });
  } else if (!dry) {
    // Settings tab was created above; seed it through the normal path.
    var fresh = readSettings_();
    missingSettings.forEach(function (key) {
      appendRecord_(fresh.store.sheet, fresh.store.headers, {
        Key: key,
        Value: CONFIG.DEFAULT_SETTINGS[key],
        'Updated at': new Date().toISOString(),
      });
    });
  }
  log.push(
    '  settings: ' +
      (missingSettings.length
        ? (dry ? 'would seed ' : 'seeded ') + missingSettings.join(', ')
        : 'all keys present, nothing to do'),
  );

  /* 3. First administrator ------------------------------------------------ */
  var usersSheetFound = findSheet_('USERS', CONFIG.SHEETS.USERS);
  var existingUsers = usersSheetFound ? readTable_('USERS', CONFIG.SHEETS.USERS).rows : [];
  var hasAdmin = existingUsers.some(function (row) {
    return normaliseRole_(row.Role) === ROLES.ADMIN && String(row['Account status']).toUpperCase() === STATUS.ACTIVE;
  });
  if (hasAdmin) {
    log.push('  admin: an ACTIVE administrator already exists — left untouched.');
  } else if (dry) {
    log.push('  admin: would seed one administrator (no ACTIVE admin found).');
  } else {
    var props = PropertiesService.getScriptProperties();
    var email = props.getProperty('SEED_ADMIN_EMAIL') || 'admin@lumina.edu';
    var password = props.getProperty('SEED_ADMIN_PASSWORD');
    if (!password) {
      password = 'Lumina@' + Math.floor(1000 + Math.random() * 9000);
      props.setProperty('SEED_ADMIN_PASSWORD', password);
    }
    var users = readTable_('USERS', CONFIG.SHEETS.USERS);
    var salt = newSalt_();
    var now = new Date().toISOString();
    appendRecord_(users.sheet, users.headers, {
      'User ID': nextId_('U', users.rows, 'User ID'),
      Name: 'Library Administrator',
      Email: email,
      'Institutional ID': 'ADMIN-001',
      Role: 'ADMIN',
      Department: 'Library',
      'Account status': 'ACTIVE',
      'Password salt': salt,
      'Password hash': hashPassword_(password, salt, CONFIG.HASH_ITERATIONS),
      'Hash iterations': CONFIG.HASH_ITERATIONS,
      Phone: '',
      'Borrowing limit': '',
      'Created at': now,
      'Updated at': now,
    });
    log.push('  admin: seeded ' + email + ' (password stored in Script property SEED_ADMIN_PASSWORD).');
    log.push('         Sign in once and change it from Profile → Change password.');
  }

  log.push('');
  log.push('Next: run verifyLuminaSetup(), then Deploy → New deployment → Web app');
  log.push('      (Execute as: Me, Who has access: Anyone) and copy the /exec URL.');

  var output = log.join('\n');
  try {
    console.log(output);
  } catch (ignored) {}
  return output;
}

/**
 * Read-only health report for the spreadsheet itself.
 * Checks: spreadsheet access, every tab, every canonical header, write permission,
 * the administrator account, settings keys and the runtime configuration.
 */
function verifyLuminaSetup() {
  var checks = [];
  function check(name, ok, detail) {
    checks.push({ name: name, ok: ok === true, detail: detail || '' });
    return ok;
  }
  /** A note about the owner's existing data: reported, but it does not fail setup. */
  function advisory(name, detail) {
    checks.push({ name: name, ok: true, advisory: true, detail: detail || '' });
    return true;
  }

  var book = null;
  try {
    book = spreadsheet_();
    check('Spreadsheet is readable', true, '"' + book.getName() + '" · ' + book.getId());
  } catch (err) {
    check('Spreadsheet is readable', false, String(err && err.message));
  }

  if (book) {
    /* Write permission: rewrite the existing value of one cell with itself. */
    try {
      var probe = readTable_('SETTINGS', CONFIG.SHEETS.SETTINGS);
      var target = probe.rows.length ? probe.rows[0] : null;
      if (target) {
        var column = columnMap_(probe.headers).Value;
        var current = probe.sheet.getRange(target._row, column).getValue();
        probe.sheet.getRange(target._row, column).setValue(current);
        check('Spreadsheet is writable', true, 'Settings!Value rewritten with its own value (no data changed)');
      } else {
        check('Spreadsheet is writable', true, 'Settings tab is empty — skipped the write probe');
      }
    } catch (err) {
      check('Spreadsheet is writable', false, String(err && err.message));
    }

    var tables = {};
    Object.keys(CONFIG.SHEETS).forEach(function (kind) {
      var sheet = findSheet_(kind, CONFIG.SHEETS[kind]);
      if (!sheet) {
        check('Tab for ' + kind, false, 'missing — run setupLumina()');
        tables[kind] = { tab: null, rows: 0, missing: CONFIG.HEADERS[kind] };
        return;
      }
      var headers = readHeaderRow_(sheet);
      var headerKeys = headers.map(headerKey_);
      var missing = CONFIG.HEADERS[kind].filter(function (header) {
        return headerKeys.indexOf(headerKey_(header)) === -1;
      });
      var rows = Math.max(0, sheet.getLastRow() - 1);
      tables[kind] = { tab: sheet.getName(), rows: rows, missing: missing };
      check(
        'Tab for ' + kind,
        missing.length === 0,
        '"' + sheet.getName() + '" · ' + rows + ' rows' + (missing.length ? ' · missing: ' + missing.join(', ') : ''),
      );
    });

    try {
      var users = readTable_('USERS', CONFIG.SHEETS.USERS);
      var admins = users.rows.filter(function (row) {
        return normaliseRole_(row.Role) === ROLES.ADMIN && String(row['Account status']).toUpperCase() === STATUS.ACTIVE;
      });
      check('An ACTIVE administrator exists', admins.length > 0, admins.length ? admins.length + ' admin account(s)' : 'run setupLumina()');
      var plain = users.rows.filter(function (row) {
        var hash = String(row['Password hash'] || '');
        return hash && hash.length < 32;
      });
      check('No obviously malformed password hashes', plain.length === 0, plain.length ? plain.length + ' row(s) look wrong' : 'all hashes are present');
    } catch (err) {
      check('Users tab can be read', false, String(err && err.message));
    }

    try {
      var books = readTable_('BOOKS', CONFIG.SHEETS.BOOKS).rows;
      var incomplete = books.filter(function (row) {
        var copies = Number(row['Total copies']);
        return !(copies > 0) || !String(row.Title || '').trim() || !String(row.Author || '').trim();
      });
      if (incomplete.length === 0) {
        check('Catalogue rows are complete', true, books.length + ' rows');
      } else {
        advisory(
          'Catalogue rows need attention',
          incomplete.length +
            ' row(s) have a blank title, author or copy count: ' +
            incomplete
              .slice(0, 5)
              .map(function (row) {
                return String(row['Book ID']);
              })
              .join(', ') +
            '. They are kept and shown with one placeholder copy — complete or delete them in the sheet. This is your data, so it does not fail setup.',
        );
      }
    } catch (err) {
      check('Catalogue rows are complete', false, String(err && err.message));
    }

    try {
      var settings = readSettings_().settings;
      var absent = Object.keys(CONFIG.DEFAULT_SETTINGS).filter(function (key) {
        return !(key in settings);
      });
      check('Policy settings present', absent.length === 0, absent.length ? 'missing: ' + absent.join(', ') : Object.keys(settings).length + ' keys');
    } catch (err) {
      check('Policy settings present', false, String(err && err.message));
    }

    check('Time zone', true, book.getSpreadsheetTimeZone());
  }

  try {
    var props = PropertiesService.getScriptProperties();
    var configuredId = props.getProperty('SPREADSHEET_ID');
    check(
      'SPREADSHEET_ID script property',
      !configuredId || configuredId === CONFIG.SPREADSHEET_ID,
      configuredId ? 'set to ' + configuredId : 'not set — using the id compiled into Config.gs',
    );
    var seedEmail = props.getProperty('SEED_ADMIN_EMAIL');
    check('SEED_ADMIN_EMAIL script property', Boolean(seedEmail), seedEmail || 'not set — defaults to admin@lumina.edu');
  } catch (err) {
    check('Script properties readable', false, String(err && err.message));
  }

  try {
    var effective = Session.getEffectiveUser().getEmail();
    var active = '';
    try {
      active = Session.getActiveUser().getEmail();
    } catch (ignored) {}
    check('Running as', true, effective + (active && active !== effective ? ' (caller: ' + active + ')' : ''));
  } catch (err) {
    check('Running as', true, 'unknown');
  }

  var failed = checks.filter(function (item) {
    return !item.ok;
  });
  var lines = ['Lumina API v' + CONFIG.VERSION + ' — setup verification', ''];
  checks.forEach(function (item) {
    var tag = item.advisory ? '  WARN  ' : item.ok ? '  PASS  ' : '  FAIL  ';
    lines.push(tag + item.name + (item.detail ? ' — ' + item.detail : ''));
  });
  lines.push('');
  lines.push(failed.length === 0 ? 'Everything looks good. Deploy the Web app next.' : failed.length + ' check(s) failed — see above.');
  lines.push('Reminder: Deploy → Manage deployments → Web app → Execute as "Me", Who has access "Anyone".');

  var output = lines.join('\n');
  try {
    console.log(output);
  } catch (ignored) {}
  return output;
}

/**
 * Emergency recovery: sets a fresh random password for one account and stores it
 * in a script property. Run manually from the editor only — never exposed as an
 * API action.
 */
function resetAdminPassword() {
  var props = PropertiesService.getScriptProperties();
  var email = (props.getProperty('SEED_ADMIN_EMAIL') || '').toLowerCase();
  var users = readTable_('USERS', CONFIG.SHEETS.USERS);
  var admin =
    users.rows.filter(function (row) {
      return normaliseRole_(row.Role) === ROLES.ADMIN && (!email || String(row.Email).toLowerCase() === email);
    })[0] || null;
  if (!admin) return 'No administrator account found. Run setupLumina() first.';
  var password = 'Lumina@' + Math.floor(1000 + Math.random() * 9000);
  var salt = newSalt_();
  updateRecord_(users.sheet, users.headers, admin._row, {
    'Password salt': salt,
    'Password hash': hashPassword_(password, salt, CONFIG.HASH_ITERATIONS),
    'Hash iterations': CONFIG.HASH_ITERATIONS,
    'Updated at': new Date().toISOString(),
  });
  props.setProperty('SEED_ADMIN_PASSWORD', password);
  var message = 'Password reset for ' + admin.Email + '. New password is in the script property SEED_ADMIN_PASSWORD.';
  try {
    console.log(message);
  } catch (ignored) {}
  return message;
}

/**
 * End-to-end self test through the deployed Web app.
 * Set the script property API_BASE_URL to your /exec URL first, then run this.
 * It only creates one uniquely-named book and then deletes it again.
 */
function runLuminaApiSelfTest() {
  var props = PropertiesService.getScriptProperties();
  var url = props.getProperty('API_BASE_URL');
  if (!url) return 'Set the script property API_BASE_URL to your deployed /exec URL first.';
  var email = props.getProperty('SEED_ADMIN_EMAIL') || 'admin@lumina.edu';
  var password = props.getProperty('SEED_ADMIN_PASSWORD');
  if (!password) return 'No SEED_ADMIN_PASSWORD script property — run setupLumina() or resetAdminPassword() first.';

  var lines = [];
  function post(action, payload, token) {
    var response = UrlFetchApp.fetch(url, {
      method: 'post',
      contentType: 'text/plain;charset=utf-8',
      payload: JSON.stringify({ action: action, payload: payload || {}, token: token || null }),
      followRedirects: true,
      muteHttpExceptions: true,
    });
    return JSON.parse(response.getContentText());
  }

  var health = post('health');
  lines.push((health.ok ? 'PASS' : 'FAIL') + ' health — ' + (health.ok ? 'v' + health.data.version : JSON.stringify(health.error)));

  var login = post('auth.login', { identifier: email, password: password });
  lines.push((login.ok ? 'PASS' : 'FAIL') + ' auth.login — ' + (login.ok ? login.data.user.role : JSON.stringify(login.error)));
  if (!login.ok) {
    var out = lines.join('\n');
    console.log(out);
    return out;
  }
  var token = login.data.token;

  var boot = post('bootstrap', {}, token);
  lines.push((boot.ok ? 'PASS' : 'FAIL') + ' bootstrap — ' + (boot.ok ? boot.data.books.length + ' books, scope ' + boot.data.scope : JSON.stringify(boot.error)));

  var title = 'Self-test ' + new Date().toISOString().slice(0, 19);
  var created = post('books.create', { title: title, author: 'Setup check', totalCopies: 1 }, token);
  lines.push((created.ok ? 'PASS' : 'FAIL') + ' books.create — ' + (created.ok ? created.data.book.bookId : JSON.stringify(created.error)));
  if (created.ok) {
    var removed = post('books.delete', { bookId: created.data.book.bookId }, token);
    lines.push((removed.ok ? 'PASS' : 'FAIL') + ' books.delete (cleanup) — ' + (removed.ok ? 'removed' : JSON.stringify(removed.error)));
  }

  var out = lines.join('\n');
  console.log(out);
  return out;
}

/* ===================== Code.gs ===================== */

/**
 * Code.gs — API router for Lumina Library.
 *
 * Contract
 *   POST  {API_URL}                body: JSON { action, token?, payload? }
 *   GET   {API_URL}?action=health  → lightweight health JSON
 *   Response: { ok: true, data } | { ok: false, error: { code, message } }
 *
 * The frontend sends `text/plain` so the request stays a CORS "simple request".
 * Roles are resolved from the Users sheet on every call — never from the body.
 */
var ACTIONS = {
  /* public */
  health: { auth: false, handler: function () { return health_(); } },
  'auth.login': { auth: false, handler: function (payload) { return authLogin_(payload); } },
  // Signed-out visitors of the public site need the catalogue; no member data crosses this line.
  'catalogue.public': { auth: false, handler: function (payload) { return publicCatalogue_(payload); } },

  /* session */
  'auth.session': { auth: true, handler: function (auth) { return { user: publicUser_(auth.user) }; } },
  'auth.logout': { auth: true, handler: authLogout_ },
  'auth.changePassword': { auth: true, handler: authChangePassword_ },

  /* bootstrap + reads */
  bootstrap: { auth: true, handler: bootstrap_ },
  'books.list': { auth: true, handler: function (auth, payload) { return listBooks_(payload); } },
  'books.get': { auth: true, handler: function (auth, payload) { return getBook_(payload); } },
  'users.list': { auth: true, handler: listUsers_ },
  'users.me': { auth: true, handler: function (auth) { return { user: publicUser_(auth.user) }; } },
  'users.updateProfile': { auth: true, handler: updateOwnProfile_ },
  'loans.list': { auth: true, handler: listLoans_ },
  'reservations.list': { auth: true, handler: listReservations_ },
  'wishlist.list': { auth: true, handler: function (auth) { return listWishlist_(auth); } },
  'wishlist.toggle': { auth: true, handler: toggleWishlist_ },
  'settings.get': { auth: true, handler: getSettings_ },
  'reports.dashboard': { auth: true, handler: function (auth) { return dashboardStats_(auth); } },
  'reports.analytics': { auth: true, handler: function (auth, payload) { return analytics_(auth, payload); } },
  'activity.list': { auth: true, handler: listActivity_ },
  'system.diagnostics': { auth: true, handler: diagnostics_ },

  /* admin mutations */
  'books.create': { auth: true, handler: createBook_ },
  'books.update': { auth: true, handler: updateBook_ },
  'books.archive': { auth: true, handler: archiveBook_ },
  'books.delete': { auth: true, handler: deleteBook_ },
  'users.create': { auth: true, handler: createUser_ },
  'users.update': { auth: true, handler: updateUser_ },
  'users.setStatus': { auth: true, handler: setUserStatus_ },
  'users.resetPassword': { auth: true, handler: resetUserPassword_ },
  'settings.update': { auth: true, handler: updateSettings_ },

  /* circulation */
  'loans.issue': { auth: true, handler: issueLoan_ },
  'loans.return': { auth: true, handler: returnLoan_ },
  'loans.renew': { auth: true, handler: renewLoan_ },
  'reservations.create': { auth: true, handler: createReservation_ },
  'reservations.cancel': { auth: true, handler: cancelReservation_ },
};

function doPost(e) {
  var body = {};
  try {
    body = parseBody_(e);
  } catch (err) {
    return json_(fail_(ERR.VALIDATION, 'Request body must be valid JSON.'));
  }
  var action = String(body.action || '');
  var entry = ACTIONS[action];
  if (!entry) return json_(fail_('UNKNOWN_ACTION', 'Unknown action: ' + sanitizeText_(action, 60)));

  try {
    // Every handler result is wrapped in the { ok, data } envelope.
    if (!entry.auth) return json_(ok_(entry.handler(body.payload || {}, body)));
    var auth = requireSession_(body.token);
    return json_(ok_(entry.handler(auth, body.payload || {}, body)));
  } catch (err) {
    logError_(action, err);
    return json_(failFromError_(err));
  }
}

/**
 * GET is a browser-friendly probe only: ?action=health (default) or ?action=ping.
 * Every data action is a POST so nothing is mutated by a link.
 */
function doGet(e) {
  var action = (e && e.parameter && e.parameter.action) || 'health';
  if (action === 'ping') {
    return json_(ok_({ pong: true, service: 'lumina-library-api', version: CONFIG.VERSION, time: new Date().toISOString() }));
  }
  if (action !== 'health') {
    return json_(fail_('UNKNOWN_ACTION', 'GET only supports ?action=health or ?action=ping. Use POST for data actions.'));
  }
  try {
    return json_(ok_(health_()));
  } catch (err) {
    logError_('health', err);
    return json_(failFromError_(err));
  }
}

function parseBody_(e) {
  if (!e || !e.postData || !e.postData.contents) return {};
  var text = e.postData.contents;
  try {
    return JSON.parse(text);
  } catch (err) {
    if (e.parameter && e.parameter.payload) return JSON.parse(e.parameter.payload);
    throw err;
  }
}

function json_(payload) {
  return ContentService.createTextOutput(JSON.stringify(payload)).setMimeType(ContentService.MimeType.JSON);
}

/** Safe health probe: no user data, no identifiers beyond tab names. */
function health_() {
  var book = spreadsheet_();
  var tabs = book.getSheets().map(function (sheet) {
    return sheet.getName();
  });
  var counts = {};
  try {
    ['BOOKS', 'USERS', 'LOANS', 'RESERVATIONS'].forEach(function (kind) {
      var table = readTable_(kind, CONFIG.SHEETS[kind]);
      counts[kind.toLowerCase()] = table.rows.length;
    });
  } catch (err) {
    counts.error = 'Some tabs could not be read.';
  }
  return {
    service: 'lumina-library-api',
    version: CONFIG.VERSION,
    // The spreadsheet id is deliberately not returned from a public endpoint.
    tabs: tabs,
    counts: counts,
    time: new Date().toISOString(),
  };
}

/** One call that gives the frontend everything it needs after login, scoped by role. */
function bootstrap_(auth) {
  var role = normaliseRole_(auth.user.Role);
  var staff = isStaff_(role);
  var books = listBooks_({}).books;
  var loans = listLoans_(auth, {}).loans;
  var reservations = listReservations_(auth, {}).reservations;
  var users = staff ? listUsers_(auth, {}).users : [publicUser_(auth.user)];
  var settings = readSettings_().settings;
  var activity = listActivity_(auth, { limit: 40 }).activity;
  var wishlist = listWishlist_(auth).wishlist;

  return {
    user: publicUser_(auth.user),
    role: role,
    scope: staff ? 'ALL' : 'SELF',
    books: books,
    users: users,
    loans: loans,
    reservations: reservations,
    settings: settings,
    activity: activity,
    wishlist: wishlist,
    stats: dashboardStats_(auth),
    serverTime: new Date().toISOString(),
  };
}

/**
 * ADMIN-only structural report: which tab backs each logical table, whether the
 * canonical headers are present, and how many rows each holds. Read-only.
 */
function diagnostics_(auth) {
  requireRole_(auth, [ROLES.ADMIN]);
  var book = spreadsheet_();
  var tables = {};
  Object.keys(CONFIG.SHEETS).forEach(function (kind) {
    var sheet = findSheet_(kind, CONFIG.SHEETS[kind]);
    if (!sheet) {
      tables[kind.toLowerCase()] = { ok: false, tab: null, missing: CONFIG.HEADERS[kind] };
      return;
    }
    var headers = readHeaderRow_(sheet);
    var headerKeys = headers.map(headerKey_);
    var missing = CONFIG.HEADERS[kind].filter(function (header) {
      return headerKeys.indexOf(headerKey_(header)) === -1;
    });
    tables[kind.toLowerCase()] = {
      ok: missing.length === 0,
      tab: sheet.getName(),
      rows: Math.max(0, sheet.getLastRow() - 1),
      columns: headers.length,
      missing: missing,
    };
  });
  var staleSessions = readTable_('SESSIONS', CONFIG.SHEETS.SESSIONS).rows.filter(function (row) {
    return new Date(row['Expires at']).getTime() < Date.now();
  }).length;
  return {
    service: 'lumina-library-api',
    version: CONFIG.VERSION,
    spreadsheet: book.getName(),
    user: String(auth.user.Email),
    role: normaliseRole_(auth.user.Role),
    timezone: book.getSpreadsheetTimeZone(),
    tables: tables,
    sessions: { expired: staleSessions },
    settings: readSettings_().settings,
    time: new Date().toISOString(),
  };
}

/**
 * Error logging. Apps Script has no log service beyond Stackdriver, so the full
 * detail goes to the execution log and only a sanitised code+message reaches the
 * client. Never logs passwords, tokens or hashes.
 */
function logError_(action, err) {
  try {
    var code = err && err.appCode ? err.appCode : ERR.SERVER;
    var message = err && err.message ? String(err.message) : 'unknown';
    // Strip anything that looks like a secret before it reaches the log.
    message = message.replace(/[A-Za-z0-9_\-]{32,}/g, '<redacted>');
    console.error('[lumina-api] action=' + sanitizeText_(action || 'unknown', 60) + ' code=' + code + ' message=' + message);
  } catch (ignored) {
    // Logging must never break a request.
  }
}
